---
// All projects: the full wall with search, filters and sort (the home shows a selection of 6).
import Base from '../../../layouts/Base.astro';
import Wall from '../../../components/Wall.astro';
import Contact from '../../../components/Contact.astro';
import { type Lang, langPaths, getProjects, useT } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const projects = await getProjects();
---
<Base lang={lang} path="work" title={t('work.allTitle').replace(/\.$/, '')} description={t('work.intro')} variant="page">
  <main class="page">
    <Wall lang={lang} projects={projects} variant="full" />
  </main>
  <Contact lang={lang} />
</Base>

<style>
  .page { padding-top: var(--header-h); }
</style>
