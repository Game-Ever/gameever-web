<script>

  // Series tabs (e.g. Canciones / A Jugar) and "Ver los N".
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.series [role=tab]')];
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  }));
  document.querySelectorAll<HTMLButtonElement>('.show-all').forEach((btn) => btn.addEventListener('click', () => {
    const panel = btn.closest('.series-panel')!;
    const open = panel.classList.toggle('expanded');
    btn.textContent = open ? btn.dataset.less! : btn.dataset.all!;
  }));

  // Kicker: if service · client does not fit on one line, break at the · instead of wrapping anywhere.
  const kick = document.querySelector<HTMLElement>('.hero .kicker');
  if (kick && kick.querySelector('.k-sep')) {
    const fit = () => { kick.classList.remove('wrapped'); kick.classList.toggle('wrapped', kick.getClientRects().length > 1); };
    fit();
    addEventListener('resize', fit);
    document.fonts?.ready.then(fit);
  }

  const stopVideos = (root: ParentNode) => (window as any).stopVideos?.(root);

  // Gallery viewer: arrows, thumbnails and swipe change the item on the stage.
  const stage = document.querySelector<HTMLElement>('.media .stage');
  if (stage) {
    const slides = [...stage.querySelectorAll<HTMLElement>('.slide')];
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.media .thumb')];
    const strip = document.querySelector<HTMLElement>('.media .strip');
    let cur = 0;
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      if (n === cur) return;
      stopVideos(slides[cur]);
      slides[cur].hidden = true;
      slides[n].hidden = false;
      thumbs.forEach((t, k) => t.setAttribute('aria-selected', String(k === n)));
      const th = thumbs[n];
      if (th && strip) strip.scrollTo({ left: th.offsetLeft - (strip.clientWidth - th.clientWidth) / 2, behavior: 'smooth' });
      cur = n;
    };
    thumbs.forEach((th, k) => th.addEventListener('click', () => go(k)));
    stage.querySelector('.st-prev')?.addEventListener('click', () => go(cur - 1));
    stage.querySelector('.st-next')?.addEventListener('click', () => go(cur + 1));
    let sx = 0;
    stage.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1));
    });
  }
</script>
