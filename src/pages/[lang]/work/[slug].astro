---
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import YouTube from '../../../components/YouTube.astro';
import LoopVideo from '../../../components/LoopVideo.astro';
import { type Lang, type Project, LANGS, useT, tr, url, getProjects, clientName, ORIGINAL_IP } from '../../../i18n';
import { SERVICES, PLATFORMS } from '../../../data/taxonomy';

export async function getStaticPaths() {
  const projects = await getProjects();
  return LANGS.flatMap((lang) =>
    projects.map((project, i) => ({
      params: { lang, slug: project.id },
      props: { project, next: projects[(i + 1) % projects.length] },
    })));
}

interface Props { project: Project; next: Project }
const lang = Astro.params.lang as Lang;
const { project, next } = Astro.props;
const d = project.data;
const t = useT(lang);

const platforms = d.platforms.map((p) => PLATFORMS[p][lang]);
const services = d.services.map((s) => SERVICES[s][lang]);
const allVideos = d.videos.length ? d.videos : d.entries.flatMap((e) => e.videos);
// No "Ver tráiler" when the page lists its videos: they are a scroll away.
const trailer = d.entries.length ? undefined : allVideos[0];
// Prefer a landscape screenshot behind the title; fall back to the square key art.
const heroBg = d.heroImage ?? d.gallery.find((g) => g.width > g.height * 1.2) ?? d.cover;
// On phones (portrait) a landscape image crops the characters, so the square cover is used there instead.
const heroNarrow = heroBg !== d.cover ? await getImage({ src: d.cover, width: 900, format: 'webp' }) : null;
// Credits split into blocks when rows carry a group (e.g. one per album): each block is a collapsible panel.
const creditBlocks = d.creditList.reduce<{ title?: string; rows: typeof d.creditList }[]>((acc, c) => {
  if (c.group || !acc.length) acc.push({ title: c.group ? tr(c.group, lang) : undefined, rows: [] });
  acc[acc.length - 1].rows.push(c);
  return acc;
}, []);
// "94 M" / "7,3 M" / "891 k" (es) and "94M" / "7.3M" / "891K" (en).
const compact = (n: number) => {
  const [v, unit] = n >= 1e6 ? [n / 1e6, lang === 'es' ? ' M' : 'M'] : [n / 1e3, lang === 'es' ? ' k' : 'K'];
  return `${v.toLocaleString(lang === 'es' ? 'es-AR' : 'en-US', { maximumFractionDigits: v < 10 ? 1 : 0 })}${unit}`;
};
// Series shown as tabs (one unnamed series when the project has no `entryGroups`).
const groups = d.entryGroups.length
  ? d.entryGroups.map((g) => ({ key: g.key, title: tr(g.title, lang), entries: d.entries.filter((e) => e.group === g.key) }))
  : [{ key: 'all', title: '', entries: d.entries }];
const SHOWN = 9; // entries visible per series before "Ver los N"
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const isGame = d.services.some((s) => ['brand-games', 'web-games', 'edutainment', 'original-ip'].includes(s)) && d.platforms.some((p) => !['youtube', 'tv'].includes(p));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isGame ? 'VideoGame' : 'CreativeWork',
  name: d.title,
  description: tr(d.description, lang),
  image: ogUrl,
  dateCreated: String(d.year),
  creator: { '@type': 'Organization', name: 'Game Ever' },
  ...(d.client !== ORIGINAL_IP ? { sponsor: { '@type': 'Organization', name: d.client } } : {}),
  ...(isGame ? { gamePlatform: platforms } : {}),
};
---
<Base lang={lang} path={`work/${project.id}`} title={d.title} description={tr(d.summary, lang)} image={ogUrl} variant="project" jsonLd={jsonLd}>
  <main>
    <section class="hero">
      <picture>
        {heroNarrow && <source media="(max-width: 760px)" srcset={heroNarrow.src} />}
        <Image class="bg" src={heroBg} alt="" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      </picture>
      {d.heroVideo && <LoopVideo id={d.heroVideo.id} start={d.heroVideo.start} end={d.heroVideo.end} class="hero-video" />}
      <div class="wrap inner">
        <div>
          <span class="mono kicker">{[services[0], d.client === ORIGINAL_IP ? null : d.client, d.years ?? d.year].filter(Boolean).join(" · ")}</span>
          <h1 class="wide">{d.title}</h1>
          <div class="tags">
            {d.genre && <span>{tr(d.genre, lang)}</span>}
            {platforms.map((p) => <span>{p}</span>)}
          </div>
          {(trailer || d.links.length > 0) && (
            <div class="ctas">
              {trailer && <button class="cta primary" data-trailer={trailer}>▶ {t('project.trailer')}</button>}
              {d.links.map((l) => <a class="cta" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
            </div>
          )}
        </div>
        <Image class="art" src={d.cover} alt={d.title} width={320} height={320} densities={[1, 2]} loading="eager" />
      </div>
    </section>

    {d.stats.length > 0 && (
      <div class="wrap">
        <ul class="stats" id="figures">
          {d.stats.map((s) => <li><strong class="wide">{s.value}</strong><span>{tr(s.label, lang)}</span></li>)}
        </ul>
      </div>
    )}

    <div class="wrap">
      <section class="overview">
        <div>
          <p class="lead">{tr(d.summary, lang)}</p>
          <p class="body">{tr(d.description, lang)}</p>
        </div>
        <dl>
          <dt>{t("project.client")}</dt><dd>{clientName(d.client, lang)}</dd>
          <dt>{t('project.year')}</dt><dd>{d.years ?? d.year}</dd>
          {platforms.length > 0 && <><dt>{t('project.platforms')}</dt><dd>{platforms.join(' · ')}</dd></>}
          {d.genre && <><dt>{t('project.genre')}</dt><dd>{tr(d.genre, lang)}</dd></>}
          {d.facts.map((x) => <><dt>{tr(x.label, lang)}</dt><dd>{tr(x.value, lang)}</dd></>)}
          {d.role && <><dt>{t('project.role')}</dt><dd>{tr(d.role, lang)}</dd></>}
          {/* Services only when there is no role: the role already says what we did. */}
          {!d.role && <><dt>{t('project.services')}</dt><dd>{services.join(' · ')}</dd></>}
        </dl>
      </section>

      {d.entries.length > 0 ? (
        <section class="block clips" id="videos">
          <div class="clips-head">
            <h2 class="wide">{d.entriesTitle ? tr(d.entriesTitle, lang) : t('project.seasons')}</h2>
            {groups.length > 1 && (
              <div class="series" role="tablist">
                {groups.map((g, i) => (
                  <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`series-${g.key}`} data-series={g.key}>
                    {g.title} <span class="mono">{g.entries.length}</span>
                  </button>
                ))}
              </div>
            )}
          </div>
          {groups.map((g, i) => (
            <div class="series-panel" id={`series-${g.key}`} role={groups.length > 1 ? 'tabpanel' : undefined} hidden={i > 0}>
              <div class:list={['entries', { featured: g.entries.some((e) => e.views) }]}>
                {g.entries.map((e, j) => (
                  <article class:list={{ more: j >= SHOWN }}>
                    {e.videos[0]
                      ? <YouTube id={e.videos[0]} title={tr(e.title, lang)} playLabel={t('project.play')} />
                      : <div class="novideo" />}
                    {j === 0 && e.views && <span class="badge">{t('project.mostViewed')}</span>}
                    <h3>{tr(e.title, lang)}</h3>
                    <span class="mono">{[e.year, e.views ? t('project.views', { n: compact(e.views) }) : null].filter(Boolean).join(' · ')}</span>
                  </article>
                ))}
              </div>
              {g.entries.length > SHOWN && (
                <button class="show-all mono" data-all={t('project.showAll', { n: g.entries.length })} data-less={t('project.showLess')}>{t('project.showAll', { n: g.entries.length })}</button>
              )}
            </div>
          ))}
        </section>
      ) : allVideos.length > 0 && (
        <section class="block">
          <div class:list={['videos', { single: allVideos.length === 1 }]}>
            {allVideos.map((id, i) => <YouTube id={id} title={`${d.title} ${i + 1}`} playLabel={t('project.play')} />)}
          </div>
        </section>
      )}

      {d.gallery.length > 0 && (
        <section class="block" aria-label={t('project.gallery')}>
          <div class="gallery">
            {d.gallery.map((src, i) => <figure><Image src={src} alt={`${d.title} — ${i + 1}`} widths={[400, 800]} sizes="(max-width: 760px) 100vw, 400px" /></figure>)}
          </div>
        </section>
      )}

      {d.process.length > 0 && (
        <section class="block" id="process">
          <h2 class="wide">{t('project.process')}</h2>
          <div class="process">
            {d.process.map((p) => (
              <figure>
                {p.image
                  ? <Image src={p.image} alt={tr(p.title, lang)} widths={[600, 900]} sizes="(max-width: 900px) 100vw, 33vw" />
                  : <div class="pending mono">{t('project.pendingImage')}</div>}
                <figcaption><h3>{tr(p.title, lang)}</h3>{p.text && <p>{tr(p.text, lang)}</p>}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      {d.creditList.length > 0 ? (
        <section class="block credit-list" id="credits">
          <div class="credits-head">
            <h2 class="wide">{t('project.credits')}</h2>
            {d.creditsPending && <span class="mono pending-tag">{t('project.creditsPending')}</span>}
          </div>
          {creditBlocks.map((b, i) => b.title ? (
            <details class="credit-block" open={i === creditBlocks.length - 1}>
              <summary class="wide">{b.title}</summary>
              <dl>{b.rows.map((c) => <><dt>{tr(c.role, lang)}</dt><dd>{c.names}</dd></>)}</dl>
            </details>
          ) : (
            <dl>{b.rows.map((c) => <><dt>{tr(c.role, lang)}</dt><dd>{c.names}</dd></>)}</dl>
          ))}
        </section>
      ) : d.credits && (
        <details class="credits">
          <summary class="wide">{t('project.credits')}</summary>
          {d.credits.split('\n\n').map((c) => <p class="mono">{c}</p>)}
        </details>
      )}
    </div>

    <a class="next" href={url(lang, `work/${next.id}`)}>
      <div class="wrap">
        <div><span class="mono">{t('project.next')}</span><h2 class="wide">{next.data.title}</h2></div>
        <Image src={next.data.cover} alt="" width={240} height={240} densities={[1, 2]} />
      </div>
    </a>
  </main>

  <footer class="foot">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Game Ever S.A.</span>
      <span>{t('project.cta')} <a href="mailto:info@gameeverstudio.com">info@gameeverstudio.com</a></span>
    </div>
  </footer>

  <div class="modal" hidden><button class="x" aria-label="Close">✕</button></div>
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Dark only where text sits: a light band under the header and the bottom third under the title. */
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 13, 15, 0.35) 0%, transparent 16%, transparent 50%, rgba(13, 13, 15, 0.8) 84%, var(--bg) 100%); }
  .inner { position: relative; z-index: 2; width: 100%; padding-top: 120px; padding-bottom: 56px; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; }
  .kicker { color: rgba(255, 255, 255, 0.8); }
  .art { width: min(320px, 28vw); height: auto; aspect-ratio: 1; object-fit: cover; box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7); }
  h1 { font-size: clamp(44px, 8.5vw, 140px); line-height: 0.88; margin: 14px 0 26px; overflow-wrap: break-word; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span { border: 1px solid rgba(255, 255, 255, 0.55); padding: 6px 11px; font-size: 14px; font-weight: 600; background: rgba(0, 0, 0, 0.25); backdrop-filter: blur(4px); }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 26px; }
  .cta { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 22px; font-weight: 800; font-stretch: 118%; text-transform: uppercase; font-size: 14px; border: 2px solid var(--fg); cursor: pointer; background: none; transition: all 0.2s; }
  .cta.primary { background: var(--pink); border-color: var(--pink); color: #fff; }
  .cta:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  .overview { display: grid; grid-template-columns: 1.5fr 1fr; gap: 80px; padding: 110px 0 90px; }
  .lead { font-size: clamp(22px, 2.3vw, 32px); line-height: 1.25; font-weight: 500; }
  .body { color: var(--fg2); margin-top: 24px; font-size: 18px; }
  dl { display: grid; grid-template-columns: auto 1fr; border-top: 1px solid var(--line); align-self: start; }
  dt, dd { padding: 14px 0; border-bottom: 1px solid var(--line); }
  dt { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); padding-right: 24px; }
  dd { font-weight: 600; }

  .block { margin-bottom: 90px; }
  .block h2 { font-size: clamp(28px, 3.4vw, 48px); margin-bottom: 28px; }
  .videos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .videos.single { grid-template-columns: 1fr; }
  .entries { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 16px; }
  .entries h3 { font-size: 18px; font-stretch: 115%; font-weight: 800; text-transform: uppercase; margin-top: 12px; line-height: 1.15; }
  .entries .mono { color: var(--mute); }
  .novideo { aspect-ratio: 16 / 9; background: var(--bg2); }

  /* Moving background: 16:9 covering the hero, its top 120px (YouTube's title) above the viewport. */
  .hero :global(.hero-video) { position: absolute; left: 50%; top: -120px; width: max(100vw, calc((100svh + 120px) * 1.7778)); height: max(calc(100svh + 120px), 56.25vw); transform: translateX(-50%); }
  .hero::after { z-index: 1; }

  /* Key figures under the title. */
  /* Each figure takes its own width and the free space is split evenly between them, so a long value ("+230 M") never looks squeezed next to short ones. */
  .stats { list-style: none; padding: 34px 0; margin: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px 48px; border-bottom: 1px solid var(--line); }
  .stats li { display: grid; gap: 6px; border-left: 3px solid var(--pink); padding-left: 16px; }
  .stats strong { font-size: clamp(32px, 3.8vw, 56px); line-height: 0.95; color: var(--fg); white-space: nowrap; }
  .stats span { color: var(--fg2); font-size: 15px; white-space: nowrap; }

  /* Clips: title with series tabs, the most viewed clip large, the rest in a grid. */
  .clips-head { display: flex; justify-content: space-between; align-items: end; gap: 20px 32px; flex-wrap: wrap; margin-bottom: 28px; }
  .clips-head h2 { margin-bottom: 0; }
  .series { display: flex; gap: 6px; flex-wrap: wrap; }
  .series button { display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 18px; border: 1px solid var(--line2); background: none; color: var(--fg2); font-weight: 800; font-stretch: 115%; text-transform: uppercase; font-size: 14px; cursor: pointer; transition: all 0.2s; }
  .series button .mono { color: var(--mute); }
  .series button:hover { border-color: var(--fg); color: var(--fg); }
  .series button[aria-selected='true'] { background: var(--pink); border-color: var(--pink); color: #fff; }
  .series button[aria-selected='true'] .mono { color: rgba(255, 255, 255, 0.85); }
  .entries article { position: relative; }
  .entries.featured article:first-child { grid-column: span 2; grid-row: span 2; }
  .entries.featured article:first-child h3 { font-size: clamp(22px, 2.2vw, 32px); }
  /* "El más visto": solid tag between the thumbnail and the title, never over the image. */
  .badge { display: inline-block; margin-top: 14px; background: var(--pink); color: #fff; padding: 6px 10px; font-size: 13px; font-weight: 800; font-stretch: 115%; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1; }
  .badge + h3 { margin-top: 10px; }
  .entries article.more { display: none; }
  .series-panel.expanded .entries article.more { display: block; }
  .show-all { margin-top: 28px; background: none; border: 1px solid var(--line2); color: var(--fg); padding: 14px 22px; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
  .show-all:hover { border-color: var(--pink); color: var(--pink); }

  /* Behind the scenes: three blocks; a missing image shows a striped placeholder. */
  .process { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .process figure { margin: 0; }
  .process img, .pending { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .pending { display: grid; place-items: center; color: var(--mute); border: 1px dashed var(--line2); background: repeating-linear-gradient(135deg, var(--bg2) 0 14px, transparent 14px 28px); }
  .process h3 { font-size: 18px; font-stretch: 115%; font-weight: 800; text-transform: uppercase; margin-top: 14px; }
  .process p { color: var(--fg2); margin-top: 6px; font-size: 16px; }

  /* Credits as role → names. */
  .credits-head { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .credits-head h2 { margin-bottom: 0; }
  .pending-tag { color: var(--pink); border: 1px solid var(--pink); padding: 5px 9px; font-size: 11px; }
  .credit-list dl { grid-template-columns: minmax(180px, 1fr) 2fr; }
  .credit-list dd { color: var(--fg2); font-weight: 500; }
  /* Sub-heading inside the credits (e.g. Game Ever / El Reino Infantil), across both columns. */
  .credit-block { border-top: 1px solid var(--line); }
  .credit-block:last-child { border-bottom: 1px solid var(--line); }
  .credit-block summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 20px 0; font-size: var(--subtitle-size); }
  .credit-block summary::-webkit-details-marker { display: none; }
  .credit-block summary::after { content: '+'; font-family: var(--mono); font-size: 26px; color: var(--pink); }
  .credit-block[open] summary::after { content: '–'; }
  .credit-block dl { margin-bottom: 24px; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .gallery figure { margin: 0; background: var(--bg2); overflow: hidden; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
  .gallery figure:hover img { transform: scale(1.04); }

  .credits { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .credits summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 28px 0; font-size: clamp(26px, 3vw, 40px); }
  .credits summary::-webkit-details-marker { display: none; }
  .credits summary::after { content: '+'; font-family: var(--mono); font-size: 28px; color: var(--pink); }
  .credits[open] summary::after { content: '–'; }
  .credits p { color: var(--fg2); line-height: 2; padding-bottom: 28px; text-transform: none; }

  .next { display: block; margin-top: 110px; border-top: 1px solid var(--line); }
  .next .wrap { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-top: 70px; padding-bottom: 70px; }
  .next .mono { color: var(--mute); }
  .next h2 { font-size: clamp(36px, 7vw, 110px); line-height: 0.88; margin-top: 14px; transition: color 0.25s; overflow-wrap: break-word; }
  .next img { width: min(240px, 30vw); height: auto; aspect-ratio: 1; object-fit: cover; transition: transform 0.6s; }
  .next:hover h2 { color: var(--pink); }
  .next:hover img { transform: rotate(-3deg) scale(1.05); }
  .foot { border-top: 1px solid var(--line); padding: 28px 0 40px; color: var(--mute); font-size: 14px; }
  .foot .wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .foot a { color: var(--fg); border-bottom: 1px solid var(--pink); }

  .modal { position: fixed; inset: 0; z-index: 60; background: rgba(0, 0, 0, 0.92); display: grid; place-items: center; padding: 16px; }
  .modal[hidden] { display: none; }
  .modal :global(iframe) { width: min(1100px, 100%); aspect-ratio: 16 / 9; border: 0; }
  .x { position: absolute; top: 18px; right: 20px; background: none; border: 0; color: #fff; font-size: 30px; cursor: pointer; }

  @media (max-width: 900px) {
    .inner { grid-template-columns: 1fr; }
    .art { order: -1; width: 140px; }
    .overview { grid-template-columns: 1fr; gap: 48px; padding: 72px 0 64px; }
    .videos, .entries { grid-template-columns: 1fr; }
    .entries.featured article:first-child { grid-column: auto; grid-row: auto; }
    .process { grid-template-columns: 1fr; }
    .credit-list dl { grid-template-columns: 1fr; }
    .credit-list dt { padding-bottom: 0; border-bottom: 0; }
    .hero :global(.hero-video) { display: none; }
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 16px; }
    .stats strong { font-size: 28px; }
    .next .wrap { flex-direction: column-reverse; align-items: flex-start; }
    .next img { width: 140px; }
  }
  /* Phones: the square cover shown whole at the top (no overlay), with the title and tags below it. */
  @media (max-width: 760px) {
    .hero { min-height: 0; display: block; padding-top: 64px; }
    .bg { position: relative; display: block; height: auto; aspect-ratio: 1 / 1; }
    .hero::after { display: none; }
    .inner { padding-top: 28px; padding-bottom: 40px; }
    .art { display: none; }
  }
</style>

<script>
  const modal = document.querySelector<HTMLElement>('.modal')!;
  const close = () => { modal.hidden = true; modal.querySelector('iframe')?.remove(); };
  document.querySelector<HTMLButtonElement>('[data-trailer]')?.addEventListener('click', (e) => {
    const id = (e.currentTarget as HTMLElement).dataset.trailer;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.allow = 'autoplay; encrypted-media; fullscreen';
    iframe.allowFullscreen = true;
    modal.append(iframe);
    modal.hidden = false;
    modal.querySelector<HTMLButtonElement>('.x')!.focus();
  });
  modal.querySelector('.x')!.addEventListener('click', close);

  // Series tabs (e.g. Canciones / A Jugar) and "Ver los N".
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.series [role=tab]')];
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  }));
  document.querySelectorAll<HTMLButtonElement>('.show-all').forEach((btn) => btn.addEventListener('click', () => {
    const panel = btn.closest('.series-panel')!;
    const open = panel.classList.toggle('expanded');
    btn.textContent = open ? btn.dataset.less! : btn.dataset.all!;
  }));
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });
</script>
