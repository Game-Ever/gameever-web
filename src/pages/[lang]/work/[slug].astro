---
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import YouTube from '../../../components/YouTube.astro';
import LoopVideo from '../../../components/LoopVideo.astro';
import Legal from '../../../components/Legal.astro';
import StoreButton from '../../../components/StoreButton.astro';
import { type Lang, type Project, LANGS, useT, tr, url, getProjects, clientName, ORIGINAL_IP } from '../../../i18n';
import { SERVICES, platformLabels } from '../../../data/taxonomy';

export async function getStaticPaths() {
  const projects = await getProjects();
  return LANGS.flatMap((lang) =>
    projects.map((project, i) => ({
      params: { lang, slug: project.id },
      props: { project, next: projects[(i + 1) % projects.length] },
    })));
}

interface Props { project: Project; next: Project }
const lang = Astro.params.lang as Lang;
const { project, next } = Astro.props;
const d = project.data;
const t = useT(lang);

const platforms = platformLabels(d.platforms, lang);
const services = d.services.map((s) => SERVICES[s][lang]);
// New media layout (being tried on Juanito first): projects with `highlights` show them big, one under the other,
// each with a title and a short text; images go in the gallery viewer; press links become cards.
// The rest keep the video grid, image grid and press list.
const mediaLayout = d.highlights.length > 0 && !d.entries.length;
const highlights = mediaLayout ? d.highlights : [];
const allVideos = d.videos.length ? d.videos : d.entries.flatMap((e) => e.videos);
// Prefer a landscape screenshot behind the title; fall back to the square key art.
const heroBg = d.heroImage ?? d.gallery.find((g) => g.width > g.height * 1.2) ?? d.cover;
// On phones (portrait) a landscape image crops the characters, so a square image is used there instead:
// `heroMobile` when the project has one, else the cover.
const heroNarrow = heroBg !== d.cover ? await getImage({ src: d.heroMobile ?? d.cover, width: 900, format: 'webp' }) : null;
// Credits split into blocks when rows carry a group (e.g. one per album): each block is a collapsible panel.
const creditBlocks = d.creditList.reduce<{ title?: string; rows: typeof d.creditList }[]>((acc, c) => {
  if (c.group || !acc.length) acc.push({ title: c.group ? tr(c.group, lang) : undefined, rows: [] });
  acc[acc.length - 1].rows.push(c);
  return acc;
}, []);
// "94 M" / "7,3 M" / "891 k" (es) and "94M" / "7.3M" / "891K" (en).
const compact = (n: number) => {
  const [v, unit] = n >= 1e6 ? [n / 1e6, lang === 'es' ? ' M' : 'M'] : [n / 1e3, lang === 'es' ? ' k' : 'K'];
  return `${v.toLocaleString(lang === 'es' ? 'es-AR' : 'en-US', { maximumFractionDigits: v < 10 ? 1 : 0 })}${unit}`;
};
// Series shown as tabs (one unnamed series when the project has no `entryGroups`).
const groups = d.entryGroups.length
  ? d.entryGroups.map((g) => ({ key: g.key, title: tr(g.title, lang), entries: d.entries.filter((e) => e.group === g.key) }))
  : [{ key: 'all', title: '', entries: d.entries }];
// Gallery viewer: images first, then the extra videos. Each image has a stage size, a full size for the
// full-screen viewer and a small one for the strip (also used, blurred, behind images that are not 16:9).
const gallery = await Promise.all(d.gallery.map(async (src) => ({
  kind: 'image' as const, src,
  full: (await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' })).src,
  thumb: (await getImage({ src, width: 640, format: 'webp' })).src,
  wide: src.width / src.height > 1.7,
})));
const media = mediaLayout ? gallery : [];
const portraitGallery = d.gallery.length > 0 && d.gallery.every((g) => g.height > g.width);
const pressVideos = d.press.filter((p) => p.video);
const pressLinks = d.press.filter((p) => !p.video && p.url);
// Title in two sizes when the project names its series: "Canciones del Zoo" small, "Vol. 3" big.
const splitTitle = (p: { title: string; series?: string }) => {
  const s = p.series;
  if (!s || !(p.title.startsWith(s) || p.title.endsWith(s))) return { small: undefined, big: p.title };
  const rest = (p.title.startsWith(s) ? p.title.slice(s.length) : p.title.slice(0, -s.length)).replace(/^[\s:·—–-]+|[\s:·—–-]+$/g, '');
  return rest ? { small: s, big: rest } : { small: undefined, big: p.title };
};
const heading = splitTitle(d);
const nextHeading = splitTitle(next.data);
const SHOWN = 9; // entries visible per series before "Ver los N"
// Link previews (WhatsApp, social): the landscape header image when there is one, else the square cover.
const og = await getImage({ src: heroBg, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const isGame = d.services.some((s) => ['brand-games', 'web-games', 'edutainment', 'original-ip'].includes(s)) && d.platforms.some((p) => !['youtube', 'tv'].includes(p));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isGame ? 'VideoGame' : 'CreativeWork',
  name: d.title,
  description: tr(d.description, lang),
  image: ogUrl,
  dateCreated: String(d.year),
  creator: { '@type': 'Organization', name: 'Game Ever' },
  ...(d.client !== ORIGINAL_IP ? { sponsor: { '@type': 'Organization', name: d.client } } : {}),
  ...(isGame ? { gamePlatform: platforms } : {}),
};
---
<Base lang={lang} path={`work/${project.id}`} title={d.title} description={tr(d.summary, lang)} image={ogUrl} variant="project" jsonLd={jsonLd}>
  <main>
    <section class="hero">
      <picture>
        {heroNarrow && <source media="(max-width: 760px)" srcset={heroNarrow.src} />}
        <Image class="bg" src={heroBg} alt="" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      </picture>
      {d.heroVideo && <LoopVideo id={d.heroVideo.id} start={d.heroVideo.start} end={d.heroVideo.end} class="hero-video" />}
      <div class="wrap inner">
        <div>
          <span class="mono kicker">{[services[0], d.client === ORIGINAL_IP ? null : d.client].filter(Boolean).join(" · ")}</span>
          <h1 class="wide">{heading.small && <><span class="series">{heading.small}</span> </>}{heading.big}</h1>
          {/* No "Ver tráiler" here: the videos are a scroll away. Only store and site buttons. */}
          {d.links.length > 0 && (
            <div class="ctas">
              {d.links.map((l) => <StoreButton lang={lang} label={l.label} url={l.url} webGame={l.webGame} />)}
            </div>
          )}
        </div>
        <Image class="art" src={d.cover} alt={d.title} width={320} height={320} densities={[1, 2]} loading="eager" />
      </div>
    </section>

    {d.stats.length > 0 && (
      <div class="wrap">
        <ul class="stats" id="figures">
          {d.stats.map((s) => <li><strong class="wide">{s.value}</strong><span>{tr(s.label, lang)}</span></li>)}
        </ul>
      </div>
    )}

    <div class="wrap">
      <section class="overview">
        <div>
          <p class="lead">{tr(d.summary, lang)}</p>
          <p class="body">{tr(d.description, lang)}</p>
        </div>
        <dl>
          <dt>{t("project.client")}</dt><dd>{d.clientUrl ? <a class="fact-link" href={d.clientUrl} target="_blank" rel="noopener">{clientName(d.client, lang)}</a> : clientName(d.client, lang)}</dd>
          <dt>{t('project.year')}</dt><dd>{d.years ?? d.year}</dd>
          {platforms.length > 0 && <><dt>{t('project.platforms')}</dt><dd>{platforms.join(' · ')}</dd></>}
          {d.genre && <><dt>{t('project.genre')}</dt><dd>{tr(d.genre, lang)}</dd></>}
          {d.facts.map((x) => <><dt>{tr(x.label, lang)}</dt><dd>{x.url ? <a class="fact-link" href={x.url} target="_blank" rel="noopener">{tr(x.value, lang)}</a> : tr(x.value, lang)}</dd></>)}
          {d.role && <><dt>{t('project.role')}</dt><dd>{tr(d.role, lang)}</dd></>}
          {/* Services only when there is no role: the role already says what we did. */}
          {!d.role && <><dt>{t('project.services')}</dt><dd>{services.join(' · ')}</dd></>}
        </dl>
      </section>
    </div>

    {highlights.length > 0 && (
      <section class="cine" aria-label={t('project.featuredVideos')}>
        <div class="wrap">
          {highlights.map((h) => (
            <div class="cine-item">
              {(h.title || h.text) && (
                <div class="cine-head">
                  {h.title && <h2 class="wide">{tr(h.title, lang)}</h2>}
                  {h.text && <div class="aside"><p>{tr(h.text, lang)}</p></div>}
                </div>
              )}
              <YouTube id={h.id} title={`${d.title}${h.title ? ` — ${tr(h.title, lang)}` : ''}`} playLabel={t('project.play')} watchLabel={t('project.watch')} sizes="(max-width: 1340px) 100vw, 1280px" />
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="wrap">
      {d.entries.length > 0 ? (
        <section class="block clips" id="videos">
          <div class="clips-head">
            <h2 class="wide">{d.entriesTitle ? tr(d.entriesTitle, lang) : t('project.seasons')}</h2>
            {groups.length > 1 && (
              <div class="series" role="tablist">
                {groups.map((g, i) => (
                  <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`series-${g.key}`} data-series={g.key}>
                    {g.title} <span class="mono">{g.entries.length}</span>
                  </button>
                ))}
              </div>
            )}
          </div>
          {groups.map((g, i) => (
            <div class="series-panel" id={`series-${g.key}`} role={groups.length > 1 ? 'tabpanel' : undefined} hidden={i > 0}>
              <div class:list={['entries', { featured: g.entries.some((e) => e.views) }]}>
                {g.entries.map((e, j) => (
                  <article class:list={{ more: j >= SHOWN }}>
                    {e.videos[0]
                      ? <YouTube id={e.videos[0]} title={tr(e.title, lang)} playLabel={t('project.play')} watchLabel={t('project.watch')} sizes={j === 0 && e.views ? '(max-width: 900px) 100vw, 66vw' : '(max-width: 900px) 100vw, 33vw'} />
                      : <div class="novideo" />}
                    {j === 0 && e.views && <span class="badge">{t('project.mostViewed')}</span>}
                    <h3>{tr(e.title, lang)}</h3>
                    <span class="mono">{[e.year, e.views ? t('project.views', { n: compact(e.views) }) : null].filter(Boolean).join(' · ')}</span>
                  </article>
                ))}
              </div>
              {g.entries.length > SHOWN && (
                <button class="show-all mono" data-all={t('project.showAll', { n: g.entries.length })} data-less={t('project.showLess')}>{t('project.showAll', { n: g.entries.length })}</button>
              )}
            </div>
          ))}
        </section>
      ) : !mediaLayout && allVideos.length > 0 ? (
        <section class="block">
          <div class:list={['videos', { single: allVideos.length === 1 }]}>
            {allVideos.map((id, i) => <YouTube id={id} title={`${d.title} ${i + 1}`} playLabel={t('project.play')} watchLabel={t('project.watch')} sizes={allVideos.length === 1 ? '(max-width: 1340px) 100vw, 1280px' : '(max-width: 900px) 100vw, 50vw'} />)}
          </div>
        </section>
      ) : null}

      {!mediaLayout && gallery.length > 0 && (
        <section class="block" aria-label={t('project.gallery')}>
          <div class:list={['gallery', { portrait: portraitGallery }]}>
            {gallery.map(({ src, full }, i) => (
              <figure>
                <button class="zoom grid-zoom" data-full={full} aria-label={`${t('project.zoom')}: ${d.title} — ${i + 1}`}>
                  <Image src={src} alt={`${d.title} — ${i + 1}`} widths={portraitGallery ? [400, 700] : [700, 1100, 1400]} sizes={portraitGallery ? '(max-width: 760px) 50vw, 25vw' : '(max-width: 760px) 100vw, 50vw'} />
                  <span class="zoom-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 4a6 6 0 1 0 3.7 10.7l5.3 5.3 1.4-1.4-5.3-5.3A6 6 0 0 0 10 4zm0 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm-1 1.5v2H7v1h2v2h1v-2h2v-1h-2v-2z" /></svg></span>
                </button>
              </figure>
            ))}
          </div>
        </section>
      )}

      {media.length > 0 && (
        <section class="block media" id="gallery" aria-label={t('project.gallery')}>
          <h2 class="wide">{t('project.gallery')}</h2>
          <div class="stage">
            {media.map((m, i) => (
              <div class="slide" data-i={i} hidden={i > 0}>
                {(
                  <button class="zoom" data-full={m.full} aria-label={`${t('project.zoom')}: ${d.title} — ${i + 1}`}>
                    {!m.wide && <img class="backdrop" src={m.thumb} alt="" aria-hidden="true" loading="lazy" />}
                    <Image class="pic" src={m.src} alt={`${d.title} — ${i + 1}`} widths={[800, 1280, 1600]} sizes="(max-width: 1340px) 100vw, 1280px" loading={i === 0 ? 'lazy' : 'lazy'} />
                    <span class="zoom-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 4a6 6 0 1 0 3.7 10.7l5.3 5.3 1.4-1.4-5.3-5.3A6 6 0 0 0 10 4zm0 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm-1 1.5v2H7v1h2v2h1v-2h2v-1h-2v-2z" /></svg></span>
                  </button>
                )}
              </div>
            ))}
            {media.length > 1 && <>
              <button class="st-nav st-prev" aria-label={t('project.prev')}>←</button>
              <button class="st-nav st-next" aria-label={t('project.nextImage')}>→</button>
            </>}
          </div>
          {media.length > 1 && (
            <div class="strip" role="tablist" aria-label={t('project.gallery')}>
              {media.map((m, i) => (
                <button class="thumb" role="tab" data-i={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${d.title} — ${i + 1}`}>
                  <img src={m.thumb} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </section>
      )}

      {d.process.length > 0 && (
        <section class="block" id="process">
          <h2 class="wide">{t('project.process')}</h2>
          <div class="process">
            {d.process.map((p) => (
              <figure class:list={{ 'has-video': !!p.video }}>
                {p.video
                  ? <YouTube id={p.video} title={tr(p.title, lang)} playLabel={t('project.play')} watchLabel={t('project.watch')} sizes="(max-width: 900px) 100vw, 66vw" />
                  : p.image
                    ? <Image src={p.image} alt={tr(p.title, lang)} widths={[600, 900]} sizes="(max-width: 900px) 100vw, 33vw" />
                    : <div class="pending mono">{t('project.pendingImage')}</div>}
                <figcaption><h3>{tr(p.title, lang)}</h3>{p.text && <p>{tr(p.text, lang)}</p>}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      {d.press.length > 0 && (
        <section class="block" id="press">
          <h2 class="wide">{t('project.press')}</h2>
          {pressVideos.length > 0 && (
            <div class="press-videos">
              {pressVideos.map((p) => (
                <figure>
                  <YouTube id={p.video!} title={`${p.outlet}: ${p.title}`} playLabel={t('project.play')} watchLabel={t('project.watch')} sizes="(max-width: 900px) 100vw, 50vw" />
                  <figcaption><span class="mono">{[p.outlet, p.year].filter(Boolean).join(' · ')}</span><strong>{p.title}</strong></figcaption>
                </figure>
              ))}
            </div>
          )}
          {mediaLayout && pressLinks.length > 0 && (
            <div class="press-cards">
              {pressLinks.map((p) => (
                <a class="press-card" href={p.url} target="_blank" rel="noopener">
                  <span class="pc-top"><span class="pc-outlet wide">{p.outlet}</span>{p.score && <span class="pc-score wide">{p.score}</span>}</span>
                  <span class="pc-title">{p.title}</span>
                  <span class="pc-foot">
                    {p.author && <span class="pc-by">{t('project.by')} <strong>{p.author}</strong></span>}
                    <span class="pc-meta mono"><span>{p.year}</span><span>{t('project.readArticle')} ↗</span></span>
                  </span>
                </a>
              ))}
            </div>
          )}
          {!mediaLayout && pressLinks.length > 0 && (
            <ul class="press">
              {pressLinks.map((p) => (
                <li><a href={p.url} target="_blank" rel="noopener">
                  <span class="mono">{[p.outlet, p.year].filter(Boolean).join(' · ')}</span>
                  <strong>{p.title}</strong>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a></li>
              ))}
            </ul>
          )}
        </section>
      )}

      {/* Credits: collapsed under one title; with several groups (e.g. one per campaign) each group is its own panel inside. */}
      {d.creditList.length > 0 && (
        <details class="credits credit-list" id="credits">
          <summary><span class="wide">{t('project.credits')}</span>{d.creditsPending && <span class="mono pending-tag">{t('project.creditsPending')}</span>}</summary>
          <div class="credits-body">
            {creditBlocks.map((b, i) => b.title ? (
              <details class="credit-block" open={i === 0}>
                <summary class="wide">{b.title}</summary>
                <dl>{b.rows.map((c) => <><dt>{tr(c.role, lang)}</dt><dd>{c.names}</dd></>)}</dl>
              </details>
            ) : (
              <dl>{b.rows.map((c) => <><dt>{tr(c.role, lang)}</dt><dd>{c.names}</dd></>)}</dl>
            ))}
          </div>
        </details>
      )}
    </div>

    <a class="next" href={url(lang, `work/${next.id}`)}>
      <div class="wrap">
        <div><span class="mono">{t('project.next')}</span><h2 class="wide">{nextHeading.small && <><span class="series">{nextHeading.small}</span> </>}{nextHeading.big}</h2></div>
        <Image src={next.data.cover} alt="" width={240} height={240} densities={[1, 2]} />
      </div>
    </a>
  </main>

  <footer class="foot">
    <div class="wrap"><Legal lang={lang} /></div>
  </footer>


  {gallery.length > 0 && (
    <div class="lightbox" role="dialog" aria-modal="true" aria-label={t('project.gallery')} hidden>
      <img alt="" />
      <button class="lb-x" aria-label={t('project.close')}>✕</button>
      {gallery.length > 1 && <>
        <button class="lb-prev" aria-label={t('project.prev')}>←</button>
        <button class="lb-next" aria-label={t('project.nextImage')}>→</button>
        <span class="lb-count mono"></span>
      </>}
    </div>
  )}
</Base>

<style>
  @property --fold { syntax: '<length>'; inherits: true; initial-value: 30px; }
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Dark only where text sits: a light band under the header and the bottom third under the title. */
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 13, 15, 0.35) 0%, transparent 16%, transparent 50%, rgba(13, 13, 15, 0.8) 84%, var(--bg) 100%); }
  .inner { position: relative; z-index: 2; width: 100%; padding-top: 120px; padding-bottom: 56px; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; }
  .kicker { color: rgba(255, 255, 255, 0.8); }
  .art { width: min(320px, 28vw); height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 18px; box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7); }
  /* Same size as the home tagline ("Soñamos. Creamos. Jugamos."). */
  h1 { font-size: clamp(30px, 6vw, 88px); line-height: 0.9; margin: 14px 0 0; overflow-wrap: break-word; }
  /* Series line over the title (e.g. "Canciones del Zoo" over "Vol. 3"), at the sub-title size. */
  h1 .series, .next h2 .series { display: block; font-size: var(--subtitle-size); line-height: 1; margin-bottom: 0.35em; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }

  .overview { display: grid; grid-template-columns: 1.5fr 1fr; gap: 80px; padding: 110px 0 90px; }
  .lead { font-size: clamp(22px, 2.3vw, 32px); line-height: 1.25; font-weight: 500; }
  .body { color: var(--fg2); margin-top: 24px; font-size: 18px; }
  dl { display: grid; grid-template-columns: auto 1fr; border-top: 1px solid var(--line); align-self: start; }
  dt, dd { padding: 14px 0; border-bottom: 1px solid var(--line); }
  dt { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); padding-right: 24px; }
  dd { font-weight: 600; }
  .fact-link { border-bottom: 1px solid var(--pink); transition: color 0.2s; }
  .fact-link:hover { color: var(--pink); }

  .block { margin-bottom: 90px; }
  .block h2 { font-size: clamp(28px, 3.4vw, 48px); margin-bottom: 28px; }
  .videos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .videos.single { grid-template-columns: 1fr; }
  .entries { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 16px; }
  .entries h3 { font-size: 18px; font-stretch: 115%; font-weight: 800; text-transform: uppercase; margin-top: 12px; line-height: 1.15; }
  .entries .mono { color: var(--mute); }
  .novideo { aspect-ratio: 16 / 9; background: var(--bg2); }

  /* Moving background: 16:9 covering the hero, its top 120px (YouTube's title) above the viewport. */
  .hero :global(.hero-video) { position: absolute; left: 50%; top: -120px; width: max(100vw, calc((100svh + 120px) * 1.7778)); height: max(calc(100svh + 120px), 56.25vw); transform: translateX(-50%); }
  .hero::after { z-index: 1; }

  /* Key figures under the title. */
  /* Each figure takes its own width and the free space is split evenly between them, so a long value ("+230 M") never looks squeezed next to short ones. */
  .stats { list-style: none; padding: 34px 0; margin: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px 48px; border-bottom: 1px solid var(--line); }
  .stats li { display: grid; gap: 6px; border-left: 3px solid var(--pink); padding-left: 16px; }
  .stats strong { font-size: clamp(32px, 3.8vw, 56px); line-height: 0.95; color: var(--fg); white-space: nowrap; }
  .stats span { color: var(--fg2); font-size: 15px; white-space: nowrap; }

  /* Clips: title with series tabs, the most viewed clip large, the rest in a grid. */
  .clips-head { display: flex; justify-content: space-between; align-items: end; gap: 20px 32px; flex-wrap: wrap; margin-bottom: 28px; }
  .clips-head h2 { margin-bottom: 0; }
  .series { display: flex; gap: 6px; flex-wrap: wrap; }
  .series button { display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 18px; border: 1px solid var(--line2); background: none; color: var(--fg2); font-weight: 800; font-stretch: 115%; text-transform: uppercase; font-size: 14px; cursor: pointer; transition: all 0.2s; }
  .series button .mono { color: var(--mute); }
  .series button:hover { border-color: var(--fg); color: var(--fg); }
  .series button[aria-selected='true'] { background: var(--pink); border-color: var(--pink); color: #fff; }
  .series button[aria-selected='true'] .mono { color: rgba(255, 255, 255, 0.85); }
  .entries article { position: relative; }
  .entries.featured article:first-child { grid-column: span 2; grid-row: span 2; }
  .entries.featured article:first-child h3 { font-size: clamp(22px, 2.2vw, 32px); }
  /* "El más visto": solid tag between the thumbnail and the title, never over the image. */
  .badge { display: inline-block; margin-top: 14px; background: var(--pink); color: #fff; padding: 6px 10px; font-size: 13px; font-weight: 800; font-stretch: 115%; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1; }
  .badge + h3 { margin-top: 10px; }
  .entries article.more { display: none; }
  .series-panel.expanded .entries article.more { display: block; }
  .show-all { margin-top: 28px; background: none; border: 1px solid var(--line2); color: var(--fg); padding: 14px 22px; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
  .show-all:hover { border-color: var(--pink); color: var(--pink); }

  /* Press: one row per article (outlet · year, title, arrow), the whole row is the link. */
  .press { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .press a { display: grid; grid-template-columns: minmax(160px, 1fr) 3fr auto; gap: 8px 24px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); transition: color 0.2s; }
  .press .mono { color: var(--mute); }
  .press strong { font-weight: 600; font-size: 18px; line-height: 1.35; }
  .press .arrow { color: var(--pink); font-size: 20px; }
  .press a:hover strong { color: var(--pink); }

  /* Behind the scenes: three blocks; a missing image shows a striped placeholder. */
  .process { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .process figure { margin: 0; }
  .process figure.has-video { grid-column: span 2; }
  .process img, .pending { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .pending { display: grid; place-items: center; color: var(--mute); border: 1px dashed var(--line2); background: repeating-linear-gradient(135deg, var(--bg2) 0 14px, transparent 14px 28px); }
  .process h3 { font-size: 18px; font-stretch: 115%; font-weight: 800; text-transform: uppercase; margin-top: 14px; }
  .process p { color: var(--fg2); margin-top: 6px; font-size: 16px; }

  /* Credits as role → names. */
  .credits-head { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .credits-head h2 { margin-bottom: 0; }
  .pending-tag { color: var(--pink); border: 1px solid var(--pink); padding: 5px 9px; font-size: 11px; }
  .credit-list dl { grid-template-columns: minmax(180px, 1fr) 2fr; }
  .credit-list dd { color: var(--fg2); font-weight: 500; }
  /* Sub-heading inside the credits (e.g. Game Ever / El Reino Infantil), across both columns. */
  .credit-block { border-top: 1px solid var(--line); }
  .credit-block:last-child { border-bottom: 1px solid var(--line); }
  .credit-block summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 20px 0; font-size: var(--subtitle-size); }
  .credit-block summary::-webkit-details-marker { display: none; }
  .credit-block summary::after { content: '+'; font-family: var(--mono); font-size: 26px; color: var(--pink); }
  .credit-block[open] summary::after { content: '–'; }
  .credit-block dl { margin-bottom: 24px; }
  /* Featured videos: a dark full-width band, one video under the other, each with a title and a short text. */
  .cine { background: var(--bg2); padding: 80px 0 90px; margin-bottom: 90px; }
  .cine-item + .cine-item { margin-top: 96px; }
  .cine-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 48px; align-items: start; margin-bottom: 32px; }
  .cine-head h2 { font-size: var(--title-size); line-height: 1; }

  /* Gallery viewer: one 16:9 stage (images whole, on a blurred copy when they are not 16:9) and a strip of thumbnails. */
  .stage { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; }
  .slide, .slide > .zoom { position: absolute; inset: 0; }
  .slide[hidden] { display: none; }
  .slide :global(.yt-lite), .slide :global(.frame) { height: 100%; }
  .zoom { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .backdrop { position: absolute; inset: -40px; width: calc(100% + 80px); height: calc(100% + 80px); object-fit: cover; filter: blur(28px) brightness(0.45); }
  .zoom .pic { position: relative; display: block; width: 100%; height: 100%; object-fit: contain; }
  .zoom-icon { position: absolute; right: 14px; bottom: 14px; display: grid; place-items: center; width: 44px; height: 44px; background: rgba(13, 13, 15, 0.7); opacity: 0; transition: opacity 0.2s; }
  .zoom-icon svg { width: 22px; height: 22px; fill: #fff; }
  .zoom:hover .zoom-icon, .zoom:focus-visible .zoom-icon { opacity: 1; }
  .st-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 48px; height: 48px; border: 0; background: rgba(13, 13, 15, 0.65); color: #fff; font-size: 22px; cursor: pointer; opacity: 0; transition: opacity 0.2s, background 0.2s; }
  .st-prev { left: 12px; }
  .st-next { right: 12px; }
  .stage:hover .st-nav, .st-nav:focus-visible { opacity: 1; }
  .st-nav:hover { background: var(--pink); }
  .strip { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: thin; padding-bottom: 4px; }
  /* Thumbnails share the stage's width (up to 320px each); with many images the strip scrolls sideways. */
  .strip { gap: 10px; margin-top: 12px; }
  .thumb { position: relative; flex: 1 1 0; min-width: 170px; max-width: 320px; aspect-ratio: 16 / 9; padding: 0; border: 2px solid transparent; background: #000; cursor: pointer; opacity: 0.55; transition: opacity 0.2s, border-color 0.2s; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb:hover { opacity: 0.9; }
  .thumb[aria-selected='true'] { opacity: 1; border-color: var(--pink); }

  /* Press cards (new layout): white sheets on the dark page with the bottom-right corner folded, like a page about
     to turn. Outlet in big black type on one line, score in a pink badge (same width on every card), full headline,
     author and year. On hover the card lifts, the fold grows and turns pink, and the outlet turns pink. */
  .press-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .press-card { --fold: 30px; position: relative; display: flex; flex-direction: column; gap: 18px; min-height: 300px; padding: 30px 28px 26px; background: var(--fg); color: var(--bg); clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--fold)), calc(100% - var(--fold)) 100%, 0 100%); transition: --fold 0.3s, transform 0.25s; }
  .press-card::after { content: ''; position: absolute; right: 0; bottom: 0; width: var(--fold); height: var(--fold); background: linear-gradient(to top left, transparent 50%, #c8c3b8 50%); box-shadow: -3px -3px 8px rgba(0, 0, 0, 0.18); transition: background 0.25s; }
  .press-card:hover { --fold: 46px; transform: translateY(-4px); }
  .press-card:hover::after { background: linear-gradient(to top left, transparent 50%, var(--pink) 50%); }
  /* Outlet name on the left (scales with the card's width so it stays on one line), small score badge on the right. */
  .press-card { container-type: inline-size; }
  .pc-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .pc-outlet { font-size: min(28px, calc((100cqi - 70px) / 10.7)); line-height: 1; text-transform: uppercase; white-space: nowrap; transition: color 0.25s; }
  .press-card:hover .pc-outlet { color: var(--pink); }
  .pc-score { flex: none; min-width: 58px; text-align: center; background: var(--pink); color: #fff; font-size: 15px; line-height: 1; padding: 7px 0; }
  .pc-title { font-size: 20px; line-height: 1.35; font-weight: 500; }
  .pc-foot { margin-top: auto; display: grid; gap: 6px; padding-top: 16px; border-top: 1px solid rgba(13, 13, 15, 0.14); }
  .pc-by { color: #4a4844; font-size: 15px; }
  .pc-by strong { color: var(--bg); font-weight: 700; }
  .pc-meta { display: flex; justify-content: space-between; gap: 12px; padding-right: 34px; color: #6d6a65; white-space: nowrap; }

  /* Image grid (projects not on the new media layout yet): images at their own shape, a click opens the viewer. */
  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; align-items: start; }
  .gallery.portrait { grid-template-columns: repeat(4, 1fr); }
  .gallery figure { margin: 0; background: var(--bg2); overflow: hidden; }
  .gallery .zoom { position: relative; height: auto; }
  .gallery img { display: block; width: 100%; height: auto; transition: transform 0.6s; }
  .gallery .zoom:hover img { transform: scale(1.03); }

  .press-videos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px 16px; margin-bottom: 32px; }
  .press-videos figure { margin: 0; }
  .press-videos figcaption { display: grid; gap: 4px; margin-top: 12px; }
  .press-videos figcaption .mono { color: var(--mute); }

  .lightbox { position: fixed; inset: 0; z-index: 70; background: rgba(0, 0, 0, 0.94); display: grid; place-items: center; padding: 64px 72px; }
  .lightbox[hidden] { display: none; }
  .lightbox img { max-width: 100%; max-height: calc(100svh - 128px); width: auto; height: auto; object-fit: contain; }
  .lightbox button { position: absolute; background: none; border: 0; color: #fff; cursor: pointer; font-size: 30px; line-height: 1; padding: 12px; transition: color 0.2s; }
  .lightbox button:hover { color: var(--pink); }
  .lb-x { top: 14px; right: 16px; }
  .lb-prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 12px; top: 50%; transform: translateY(-50%); }
  .lb-count { position: absolute; bottom: 22px; left: 0; right: 0; text-align: center; color: var(--fg2); }

  .credits { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .credits > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 16px; padding: 28px 0; font-size: clamp(26px, 3vw, 40px); }
  .credits > summary::-webkit-details-marker { display: none; }
  .credits > summary::after { content: '+'; margin-left: auto; font-family: var(--mono); font-size: 28px; color: var(--pink); }
  .credits[open] > summary::after { content: '–'; }
  .credits-body { padding-bottom: 32px; }
  .credits-body > dl { border-top: 1px solid var(--line); }
  .credits p { color: var(--fg2); line-height: 2; padding-bottom: 28px; text-transform: none; }

  .next { display: block; margin-top: 110px; border-top: 1px solid var(--line); }
  .next .wrap { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-top: 70px; padding-bottom: 70px; }
  .next .mono { color: var(--mute); }
  .next h2 { font-size: clamp(30px, 6vw, 88px); line-height: 0.9; margin-top: 14px; transition: color 0.25s; overflow-wrap: break-word; }
  .next img { width: min(240px, 30vw); height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 14px; transition: transform 0.6s; }
  .next:hover h2 { color: var(--pink); }
  .next:hover img { transform: rotate(-3deg) scale(1.05); }
  /* Same bottom line as the home: version and rights. */
  .foot { padding: 40px 0 20px; }


  @media (max-width: 900px) {
    .inner { grid-template-columns: 1fr; }
    .art { order: -1; width: 140px; }
    .overview { grid-template-columns: 1fr; gap: 48px; padding: 72px 0 64px; }
    .videos, .entries { grid-template-columns: 1fr; }
    .entries.featured article:first-child { grid-column: auto; grid-row: auto; }
    .process { grid-template-columns: 1fr; }
    .process figure.has-video { grid-column: auto; }
    .press-videos { grid-template-columns: 1fr; }
    .press a { grid-template-columns: 1fr auto; }
    .press .mono { grid-column: 1 / -1; }
    .credit-list dl { grid-template-columns: 1fr; }
    .credit-list dt { padding-bottom: 0; border-bottom: 0; }
    .hero :global(.hero-video) { display: none; }
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 16px; }
    .stats strong { font-size: 28px; }
    .next .wrap { flex-direction: column-reverse; align-items: flex-start; }
    .next img { width: 140px; }
  }
  /* Phones: the square cover shown whole at the top (no overlay), with the title and buttons below it. */
  @media (max-width: 760px) {
    .hero { min-height: 0; display: block; padding-top: 64px; }
    .bg { position: relative; display: block; height: auto; aspect-ratio: 1 / 1; }
    /* The square image fades into the page at the bottom, like the desktop hero. */
    .hero picture { position: relative; display: block; }
    .hero picture::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(13, 13, 15, 0.6) 80%, var(--bg) 100%); pointer-events: none; }
    .hero::after { display: none; }
    .inner { padding-top: 28px; padding-bottom: 40px; }
    .art { display: none; }
    /* Trailer and store buttons stacked, full width. */
    .ctas { display: grid; grid-template-columns: 1fr; }
    .cine { padding: 48px 0 56px; margin-bottom: 64px; }
    .cine .wrap { padding-left: 0; padding-right: 0; }
    .cine-head { grid-template-columns: 1fr; padding: 0 var(--gutter); margin-bottom: 20px; }
    .cine-item + .cine-item { margin-top: 64px; }
    .press-card { min-height: 0; }
    .gallery { grid-template-columns: 1fr; }
    .gallery.portrait { grid-template-columns: 1fr 1fr; }
    .media .stage { margin: 0 calc(-1 * var(--gutter)); }
    .media .strip { margin-right: calc(-1 * var(--gutter)); }
    .strip { gap: 8px; margin-top: 10px; }
    .thumb { flex: none; min-width: 0; width: 104px; }
    .zoom-icon { opacity: 1; width: 34px; height: 34px; }
    .lightbox { padding: 56px 8px; }
    .lb-prev, .lb-next { top: auto; bottom: 8px; transform: none; }
  }
</style>

<script>

  // Series tabs (e.g. Canciones / A Jugar) and "Ver los N".
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.series [role=tab]')];
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  }));
  document.querySelectorAll<HTMLButtonElement>('.show-all').forEach((btn) => btn.addEventListener('click', () => {
    const panel = btn.closest('.series-panel')!;
    const open = panel.classList.toggle('expanded');
    btn.textContent = open ? btn.dataset.less! : btn.dataset.all!;
  }));

  const stopVideos = (root: ParentNode) => (window as any).stopVideos?.(root);

  // Gallery viewer: arrows, thumbnails and swipe change the item on the stage.
  const stage = document.querySelector<HTMLElement>('.media .stage');
  if (stage) {
    const slides = [...stage.querySelectorAll<HTMLElement>('.slide')];
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.media .thumb')];
    const strip = document.querySelector<HTMLElement>('.media .strip');
    let cur = 0;
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      if (n === cur) return;
      stopVideos(slides[cur]);
      slides[cur].hidden = true;
      slides[n].hidden = false;
      thumbs.forEach((t, k) => t.setAttribute('aria-selected', String(k === n)));
      const th = thumbs[n];
      if (th && strip) strip.scrollTo({ left: th.offsetLeft - (strip.clientWidth - th.clientWidth) / 2, behavior: 'smooth' });
      cur = n;
    };
    thumbs.forEach((th, k) => th.addEventListener('click', () => go(k)));
    stage.querySelector('.st-prev')?.addEventListener('click', () => go(cur - 1));
    stage.querySelector('.st-next')?.addEventListener('click', () => go(cur + 1));
    let sx = 0;
    stage.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1));
    });
  }

  // Gallery viewer: click an image to see it large; arrows, keyboard (← → Esc) and swipe move between images.
  const lb = document.querySelector<HTMLElement>('.lightbox');
  if (lb) {
    const shots = [...document.querySelectorAll<HTMLButtonElement>('.media .zoom, .gallery .zoom')];
    const img = lb.querySelector('img')!;
    const count = lb.querySelector('.lb-count');
    let at = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      at = (i + shots.length) % shots.length;
      img.src = shots[at].dataset.full!;
      img.alt = shots[at].querySelector('img')?.alt ?? '';
      if (count) count.textContent = `${at + 1} / ${shots.length}`;
    };
    const shut = () => { lb.hidden = true; document.documentElement.style.overflow = ''; opener?.focus(); };
    shots.forEach((s, i) => s.addEventListener('click', () => {
      opener = s; show(i); lb.hidden = false; document.documentElement.style.overflow = 'hidden';
      lb.querySelector<HTMLButtonElement>('.lb-x')!.focus();
    }));
    lb.querySelector('.lb-x')!.addEventListener('click', shut);
    lb.querySelector('.lb-prev')?.addEventListener('click', () => show(at - 1));
    lb.querySelector('.lb-next')?.addEventListener('click', () => show(at + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) shut(); });
    addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') shut();
      else if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
    });
    let x0 = 0;
    lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50 && shots.length > 1) show(at + (dx < 0 ? 1 : -1));
    });
  }
</script>
