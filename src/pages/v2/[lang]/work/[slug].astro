---
import { Image } from 'astro:assets';
import BaseV2 from '../../../../layouts/BaseV2.astro';
import YouTube from '../../../../components/YouTube.astro';
import { type Lang, type Project, LANGS, tr, getProjects, clientName } from '../../../../i18n';
import { useV2, v2url } from '../../../../i18n/v2';
import { SERVICES, PLATFORMS } from '../../../../data/taxonomy';

export async function getStaticPaths() {
  const projects = await getProjects();
  return LANGS.flatMap((lang) =>
    projects.map((project, i) => ({
      params: { lang, slug: project.id },
      props: { project, more: [1, 2, 3, 4].map((k) => projects[(i + k) % projects.length]) },
    })));
}

interface Props { project: Project; more: Project[] }
const lang = Astro.params.lang as Lang;
const { project, more } = Astro.props;
const d = project.data;
const t = useV2(lang);
const platforms = d.platforms.map((p) => PLATFORMS[p][lang]);
const services = d.services.map((s) => SERVICES[s][lang]);
const allVideos = d.videos.length ? d.videos : d.entries.flatMap((e) => e.videos);
const facts = [
  { k: t('project.client'), v: clientName(d.client, lang) },
  { k: t('project.year'), v: d.years ?? String(d.year) },
  ...(platforms.length ? [{ k: t('project.platforms'), v: platforms.join(' · ') }] : []),
  ...(d.genre ? [{ k: t('project.genre'), v: tr(d.genre, lang) }] : []),
];
---
<BaseV2 lang={lang} path={`work/${project.id}`} title={d.title} description={tr(d.summary, lang)}>
  <main>
    <section class="hero">
      <div class="wrap">
        <div>
          <a class="back" href={`${v2url(lang)}#archive`}>← {t('project.back')}</a>
          <h1 class="display">{d.title}</h1>
          <p class="sub">{tr(d.summary, lang)}</p>
          <div class="ctas">
            {allVideos[0] && <button class="pill ink" data-trailer={allVideos[0]}>▶ {t('project.trailer')}</button>}
            {d.links.map((l) => <a class="pill white" href={l.url} target="_blank" rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>)}
          </div>
        </div>
        <Image class="art" src={d.cover} alt={d.title} width={460} height={460} densities={[1, 2]} loading="eager" />
      </div>
    </section>

    <section class="facts" aria-label="Facts">
      <dl class="wrap">
        {facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
      </dl>
    </section>

    <section class="about">
      <div class="wrap">
        <h2 class="h2">{t('project.about')}</h2>
        <div>
          <p class="desc">{tr(d.description, lang)}</p>
          {d.role && <p class="role"><strong>{t('project.role')}:</strong> {tr(d.role, lang)}</p>}
          <ul class="chips">{services.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
    </section>

    {d.entries.length > 0 ? (
      <section class="media">
        <div class="wrap">
          <h2 class="h2">{t('project.seasons')}</h2>
          <div class="vgrid">
            {d.entries.map((e) => (
              <div>
                {e.videos[0] ? <YouTube id={e.videos[0]} title={tr(e.title, lang)} playLabel={t('project.play')} /> : <div class="novideo" />}
                <h3>{tr(e.title, lang)}</h3>
                <p class="year">{e.year}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    ) : allVideos.length > 0 && (
      <section class="media">
        <div class="wrap">
          <h2 class="h2">{t('project.videos')}</h2>
          <div class:list={['vgrid', { one: allVideos.length === 1 }]}>
            {allVideos.map((id, i) => <YouTube id={id} title={`${d.title} ${i + 1}`} playLabel={t('project.play')} />)}
          </div>
        </div>
      </section>
    )}

    {d.gallery.length > 0 && (
      <section class="gallery">
        <div class="wrap">
          <h2 class="h2">{t('project.gallery')}</h2>
          <div class="ggrid">
            {d.gallery.map((src, i) => <Image src={src} alt={`${d.title} — ${i + 1}`} widths={[400, 800]} sizes="(max-width: 760px) 50vw, 25vw" />)}
          </div>
        </div>
      </section>
    )}

    {d.credits && (
      <section class="credits">
        <div class="wrap">
          <details>
            <summary class="h2">{t('project.credits')}</summary>
            {d.credits.split('\n\n').map((c) => <p>{c}</p>)}
          </details>
        </div>
      </section>
    )}

    <section class="cta">
      <div class="wrap">
        <div><h2 class="h2">{t('project.ctaTitle')}</h2><p>{t('project.ctaBody')}</p></div>
        <a class="pill ink" href="mailto:info@gameeverstudio.com">info@gameeverstudio.com <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="more">
      <div class="wrap">
        <h2 class="h2">{t('project.more')}</h2>
        <ul>
          {more.map((p) => (
            <li>
              <a href={v2url(lang, `work/${p.id}`)}>
                <Image src={p.data.cover} alt="" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 25vw" />
                <h3>{p.data.title}</h3>
                <p class="client">{clientName(p.data.client, lang)}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <div class="modal" hidden><button class="x" aria-label={t('close')}>✕</button></div>
</BaseV2>

<style>
  .hero { background: var(--pink); color: #fff; padding: 56px 0 64px; }
  .hero .wrap { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .back { display: inline-block; font-weight: 800; text-transform: uppercase; font-size: 14px; letter-spacing: 0.04em; text-decoration: none; border-bottom: 2px solid #fff; margin-bottom: 24px; }
  h1 { font-size: clamp(52px, 8vw, 128px); overflow-wrap: break-word; }
  .sub { font-size: clamp(20px, 1.8vw, 26px); margin-top: 18px; max-width: 40ch; font-weight: 500; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  .ctas button { cursor: pointer; }
  .art { width: min(460px, 34vw); height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 16px; box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.5); }

  .facts { background: var(--ink); color: #fff; }
  .facts dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .facts div { padding: 28px 0; border-left: 1px solid rgba(255, 255, 255, 0.15); padding-left: 24px; }
  .facts div:first-child { border-left: 0; padding-left: 0; }
  dt { text-transform: uppercase; font-size: 13px; letter-spacing: 0.06em; color: var(--candy); font-weight: 700; }
  dd { font-family: var(--display); font-size: clamp(22px, 2vw, 30px); text-transform: uppercase; margin-top: 4px; line-height: 1.1; }

  .about { padding: 88px 0; }
  .about .wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; }
  .desc { font-size: 21px; line-height: 1.6; }
  .role { margin-top: 20px; color: var(--ink2); }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .chips li { border: 2px solid var(--ink); border-radius: 48px; padding: 6px 16px 5px; font-weight: 700; font-size: 14px; }

  .media { background: var(--blush); padding: 88px 0; }
  .vgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 20px; margin-top: 36px; }
  .vgrid.one { grid-template-columns: minmax(0, 900px); }
  .vgrid h3 { font-size: 20px; font-weight: 700; margin-top: 12px; }
  .year { color: var(--ink2); font-size: 15px; }
  .novideo { aspect-ratio: 16 / 9; background: rgba(0, 0, 0, 0.08); }

  .gallery { padding: 88px 0; }
  .ggrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-top: 36px; }
  .ggrid img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }

  .credits { padding: 0 0 88px; }
  details { border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 24px 0; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--pink); }
  details[open] summary::after { content: '–'; }
  details p { padding-bottom: 24px; color: var(--ink2); line-height: 1.9; font-size: 15px; }

  .cta { background: var(--candy); padding: 48px 0; }
  .cta .wrap { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta p { margin-top: 8px; font-weight: 500; }

  .more { padding: 88px 0; }
  .more ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 36px; }
  .more a { display: block; text-decoration: none; text-align: center; }
  .more img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; margin-bottom: 14px; transition: transform 0.5s; }
  .more a:hover img { transform: scale(1.03); }
  .more h3 { font-size: 20px; font-weight: 500; text-decoration: underline; text-underline-offset: 5px; }
  .more a:hover h3 { color: var(--pink); }
  .client { font-weight: 800; font-style: italic; margin-top: 6px; font-size: 15px; }

  .modal { position: fixed; inset: 0; z-index: 80; background: rgba(13, 13, 15, 0.92); display: grid; place-items: center; padding: 16px; }
  .modal[hidden] { display: none; }
  .modal :global(iframe) { width: min(1100px, 100%); aspect-ratio: 16 / 9; border: 0; }
  .x { position: absolute; top: 16px; right: 20px; background: none; border: 0; color: #fff; font-size: 30px; cursor: pointer; }

  @media (max-width: 900px) {
    .hero .wrap, .about .wrap { grid-template-columns: 1fr; }
    .art { order: -1; width: 180px; }
    .vgrid { grid-template-columns: 1fr; }
    .more ul { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .facts div { border-left: 0; padding-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.15); padding: 18px 0; }
    .facts div:first-child { border-top: 0; }
    .about, .media, .gallery, .more { padding: 64px 0; }
  }
</style>

<script>
  const modal = document.querySelector<HTMLElement>('.modal')!;
  const close = () => { modal.hidden = true; modal.querySelector('iframe')?.remove(); };
  document.querySelector<HTMLButtonElement>('[data-trailer]')?.addEventListener('click', (e) => {
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${(e.currentTarget as HTMLElement).dataset.trailer}?autoplay=1&rel=0`;
    iframe.allow = 'autoplay; encrypted-media; fullscreen';
    iframe.allowFullscreen = true;
    modal.append(iframe);
    modal.hidden = false;
    modal.querySelector<HTMLButtonElement>('.x')!.focus();
  });
  modal.querySelector('.x')!.addEventListener('click', close);
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });
</script>
