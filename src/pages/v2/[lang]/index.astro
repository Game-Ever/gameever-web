---
import { Image } from 'astro:assets';
import BaseV2 from '../../../layouts/BaseV2.astro';
import Archive from '../../../components/v2/Archive.astro';
import YouTube from '../../../components/YouTube.astro';
import { type Lang, langPaths, getProjects, tr, clientName, CLIENTS, REEL_ID, ORIGINAL_IP } from '../../../i18n';
import { useV2, v2url } from '../../../i18n/v2';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useV2(lang);
const projects = await getProjects();
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
const landscape = (id: string) => byId[id].data.gallery.find((g) => g.width > g.height * 1.2) ?? byId[id].data.cover;

// Every number here is computed from the portfolio, so it stays true as projects are added.
const stats = [
  { n: new Date().getFullYear() - 2010, suffix: '', label: t('stats.years') },
  { n: projects.length, suffix: '', label: t('stats.projects') },
  { n: new Set(projects.map((p) => p.data.client).filter((c) => c !== ORIGINAL_IP)).size, suffix: '+', label: t('stats.clients') },
  { n: projects.filter((p) => p.data.services.includes('original-ip')).length, suffix: '', label: t('stats.ips') },
  { n: new Set(projects.flatMap((p) => p.data.platforms)).size, suffix: '', label: t('stats.platforms') },
];

const paths = [
  { key: 'brand', sv: 'brand-games', img: byId['be-cool-scooby-doo'].data.cover },
  { key: 'codev', sv: 'codev', img: landscape('okhlos') },
  { key: 'anim', sv: 'animation-3d', img: byId['lit-killah-bizarrap-flexin'].data.cover },
  { key: 'ip', sv: 'original-ip', img: landscape('juanito-arcade-mayhem') },
] as const;

const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const videos = [
  { id: REEL_ID, title: t('videos.reel') },
  { id: byId['lit-killah-the-game'].data.videos[0], title: t('videos.lit') },
  { id: byId['lit-killah-bizarrap-flexin'].data.videos[0], title: t('videos.flexin') },
].filter((v) => v.id);
const reelSrc = `https://www.youtube-nocookie.com/embed/${REEL_ID}?autoplay=1&mute=1&loop=1&playlist=${REEL_ID}&controls=0&rel=0&playsinline=1&modestbranding=1&iv_load_policy=3&disablekb=1&enablejsapi=1`;
---
<BaseV2 lang={lang} path="" description={t('about.p1')}>
  <main>
    <!-- HERO -->
    <section class="hero">
      <img class="poster" src={`https://i.ytimg.com/vi/${REEL_ID}/maxresdefault.jpg`} alt="" fetchpriority="high" />
      <iframe class="yt" title={t('videos.reel')} allow="autoplay; encrypted-media" tabindex="-1" data-src={reelSrc}></iframe>
      <div class="wrap hero-in">
        <h1 class="display">{t('hero.title')}</h1>
        <p class="sub">{t('hero.sub')}</p>
        <p class="place">{t('hero.place')}</p>
      </div>
      <button class="pause" aria-label="Pause" data-pause={lang === 'es' ? 'Pausar' : 'Pause'} data-play={lang === 'es' ? 'Reproducir' : 'Play'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
      </button>
    </section>

    <!-- STATS -->
    <section class="stats" aria-label="Game Ever in numbers">
      <ul class="wrap">
        {stats.map((s) => (
          <li><span class="num display" data-to={s.n}>{s.n}</span><span class="plus">{s.suffix}</span><span class="label">{s.label}</span></li>
        ))}
      </ul>
    </section>

    <!-- BANNER -->
    <section class="banner">
      <div class="wrap">
        <div>
          <h2 class="h2">{t('banner.title')}</h2>
          <p>{t('banner.body')}</p>
        </div>
        <a class="pill ink" href="mailto:info@gameeverstudio.com">info@gameeverstudio.com <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about">
      <div class="wrap">
        <Image class="about-img" src={landscape('juanito-arcade-mayhem')} alt="Juanito Arcade Mayhem" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 50vw" />
        <div>
          <h2 class="display">{t('about.title')}</h2>
          <p>{t('about.p1')}</p>
          <p>{t('about.p2')}</p>
          <a class="pill pink" href="#archive">{t('about.cta')} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- FIND YOUR PATH -->
    <section class="paths" id="paths">
      <div class="wrap">
        <h2 class="h2">{t('path.title')}</h2>
        <p class="intro">{t('path.intro')}</p>
        <div class="cards">
          {paths.map((p) => (
            <article>
              <Image src={p.img} alt="" widths={[400, 700]} sizes="(max-width: 760px) 100vw, 25vw" />
              <h3>{t(`path.${p.key}.title`)}</h3>
              <p>{t(`path.${p.key}.body`)}</p>
              <a class="link" href={`?sv=${p.sv}#archive`} data-archive-sv={p.sv}>{t(`path.${p.key}.cta`)}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- BAND -->
    <section class="band">
      <div class="wrap">
        <h2 class="h2">{t('band.title')}</h2>
        <p>{t('band.body')}</p>
        <a class="pill pink" href="mailto:info@gameeverstudio.com">{t('band.cta')} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- WHY -->
    <section class="why">
      <div class="wrap">
        <h2 class="display kicker">{t('why.kicker')}</h2>
        <h3>{t('why.title')}</h3>
        <ul>{t('why.items').map(([b, rest]) => <li><strong>{b}</strong> — {rest}</li>)}</ul>
      </div>
    </section>

    <!-- FEATURED -->
    <section class="featured" id="featured">
      <div class="wrap">
        <h2 class="h2">{t('featured.title')}</h2>
        <p class="intro">{t('featured.intro')}</p>
        <div class="feat">
          {featured.map((p) => (
            <article>
              <a class="feat-img" href={v2url(lang, `work/${p.id}`)} tabindex="-1" aria-hidden="true">
                <Image src={p.data.gallery.find((g) => g.width > g.height * 1.2) ?? p.data.cover} alt="" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 33vw" />
              </a>
              <h3>{p.data.title}</h3>
              <p class="who">{clientName(p.data.client, lang)} · {p.data.years ?? p.data.year}</p>
              <p>{tr(p.data.summary, lang)}</p>
              <a class="link" href={v2url(lang, `work/${p.id}`)}>{t('featured.cta')}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Archive lang={lang} projects={projects} />

    <!-- VIDEOS -->
    <section class="videos" id="videos">
      <div class="wrap">
        <h2 class="h2">{t('videos.title')}</h2>
        <div class="vgrid">
          {videos.map((v) => (
            <div>
              <YouTube id={v.id} title={v.title} playLabel={t('project.play')} />
              <p class="vcap">{v.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="clients" id="clients">
      <div class="wrap">
        <h2 class="h2">{t('clients.title')}</h2>
        <ul>{CLIENTS.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>
  </main>
</BaseV2>

<style>
  /* HERO */
  .hero { position: relative; min-height: min(78vh, 720px); display: flex; align-items: flex-end; overflow: hidden; background: var(--ink); color: #fff; }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .yt { position: absolute; top: 50%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100%; min-width: 177.78vh; transform: translate(-50%, -50%); border: 0; pointer-events: none; opacity: 0; transition: opacity 1.2s; }
  .yt.on { opacity: 1; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 13, 15, 0.1) 30%, rgba(13, 13, 15, 0.75) 100%); pointer-events: none; }
  .hero-in { position: relative; z-index: 2; width: 100%; padding-top: 120px; padding-bottom: 56px; }
  h1 { font-size: clamp(56px, 10vw, 150px); max-width: 12ch; }
  .sub { font-size: clamp(22px, 2.2vw, 30px); margin-top: 18px; font-weight: 500; }
  .place { font-size: 18px; margin-top: 6px; opacity: 0.9; }
  .pause { position: absolute; right: var(--gutter); bottom: 28px; z-index: 3; width: 48px; height: 48px; border-radius: 50%; border: 2px solid #fff; background: rgba(0, 0, 0, 0.3); display: grid; place-items: center; cursor: pointer; }
  .pause:hover { background: var(--pink); border-color: var(--pink); }
  .pause :global(svg) { width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 2.4; }

  /* STATS */
  .stats { background: var(--ink); color: #fff; padding: 36px 0; }
  .stats ul { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; text-align: center; }
  .num { font-size: clamp(56px, 5.5vw, 76px); line-height: 1.1; }
  .plus { font-family: var(--display); font-size: 28px; color: var(--pink); vertical-align: top; margin-left: 2px; }
  .label { display: block; text-transform: uppercase; font-size: 15px; letter-spacing: 0.04em; margin-top: 4px; }

  /* BANNER */
  .banner { background: var(--candy); padding: 48px 0; }
  .banner .wrap { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .banner .h2 { font-size: clamp(30px, 3.2vw, 48px); max-width: 26ch; }
  .banner p { margin-top: 10px; font-weight: 500; }

  /* ABOUT */
  .about { background: var(--blush); padding: 64px 0; }
  .about .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .about-img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 16px; }
  .about h2 { font-size: clamp(48px, 6vw, 96px); margin-bottom: 24px; }
  .about p { margin-bottom: 16px; color: var(--ink2); }
  .about .pill { margin-top: 12px; }

  /* PATHS */
  .paths { padding: 96px 0; }
  .paths .h2, .featured .h2 { color: var(--ink); }
  .intro { max-width: 760px; margin: 14px 0 40px; color: var(--ink2); }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .cards img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .cards h3, .feat h3 { font-size: 26px; font-weight: 500; text-transform: uppercase; margin: 22px 0 12px; line-height: 1.15; }
  .cards p { color: var(--ink2); font-size: 17px; margin-bottom: 18px; }

  /* BAND */
  .band { background: var(--blush); padding: 56px 0; text-align: center; }
  .band p { max-width: 640px; margin: 14px auto 24px; color: var(--ink2); }

  /* WHY */
  .why { padding: 96px 0; }
  .kicker { color: var(--pink); font-size: clamp(48px, 5vw, 72px); }
  .why h3 { font-size: clamp(26px, 2.4vw, 34px); font-weight: 300; margin: 10px 0 28px; }
  .why ul { columns: 2; column-gap: 56px; padding-left: 22px; }
  .why li { break-inside: avoid; margin-bottom: 16px; color: var(--ink2); }
  .why li::marker { color: var(--pink); }
  .why strong { color: var(--ink); }

  /* FEATURED */
  .featured { padding: 96px 0; border-top: 1px solid var(--line); }
  .feat { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .feat-img { display: block; overflow: hidden; border-radius: 16px; }
  .feat-img img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 0.5s; }
  .feat-img:hover img { transform: scale(1.04); }
  .who { font-weight: 800; font-style: italic; margin-bottom: 8px; }
  .feat p:not(.who) { color: var(--ink2); margin-bottom: 18px; }

  /* VIDEOS */
  .videos { background: var(--blush); padding: 96px 0; }
  .vgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }
  .vcap { font-weight: 700; margin-top: 12px; }

  /* CLIENTS */
  .clients { background: var(--ink); color: #fff; padding: 80px 0; text-align: center; }
  .clients .h2 { max-width: 22ch; margin: 0 auto; }
  .clients ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; margin-top: 48px; }
  .clients li { background: rgba(255, 255, 255, 0.06); padding: 30px 12px; font-family: var(--display); font-size: clamp(20px, 2vw, 28px); text-transform: uppercase; letter-spacing: 0.02em; transition: background 0.2s; }
  .clients li:hover { background: var(--pink); }

  @media (max-width: 1100px) {
    .stats ul { grid-template-columns: repeat(3, 1fr); }
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .about .wrap { grid-template-columns: 1fr; }
    .feat, .vgrid { grid-template-columns: 1fr; }
    .why ul { columns: 1; }
    .clients ul { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .hero { min-height: 72vh; }
    .stats ul { grid-template-columns: repeat(2, 1fr); }
    .stats li:last-child { grid-column: 1 / -1; }
    .cards { grid-template-columns: 1fr; }
    .paths, .why, .featured, .videos { padding: 64px 0; }
  }
</style>

<script>
  // Background reel
  const yt = document.querySelector<HTMLIFrameElement>('.hero .yt');
  const pause = document.querySelector<HTMLButtonElement>('.hero .pause');
  if (yt && pause) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let playing = false;
    const ICON = { pause: '<svg viewBox="0 0 24 24"><path d="M8 5v14M16 5v14"/></svg>', play: '<svg viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"/></svg>' };
    const set = (p: boolean) => { playing = p; pause.innerHTML = p ? ICON.pause : ICON.play; pause.setAttribute('aria-label', p ? pause.dataset.pause! : pause.dataset.play!); };
    const load = () => { yt.src = yt.dataset.src!; yt.addEventListener('load', () => setTimeout(() => yt.classList.add('on'), 1200), { once: true }); set(true); };
    if (reduce) set(false); else load();
    pause.addEventListener('click', () => {
      if (!yt.getAttribute('src')) return load();
      yt.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: playing ? 'pauseVideo' : 'playVideo', args: [] }), '*');
      set(!playing);
    });
  }

  // Count-up numbers when the stats band enters the screen
  const nums = [...document.querySelectorAll<HTMLElement>('.stats .num')];
  // The real numbers are in the HTML; they only reset to 0 once the animation actually starts.
  if (nums.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / 1400);
        const ease = 1 - Math.pow(1 - p, 3);
        nums.forEach((n) => (n.textContent = String(Math.round(+n.dataset.to! * ease))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.4 });
    io.observe(nums[0].closest('section')!);
  }
</script>
