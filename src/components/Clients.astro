---
import Dot from './Dot.astro';
import { Image } from 'astro:assets';
import { type Lang, useT } from '../i18n';
import { CLIENT_LOGOS } from '../data/clients';

interface Props { lang: Lang }
const t = useT(Astro.props.lang);
---
<section class="clients" id="clients">
  <div class="wrap">
    <span class="mono kicker">{t('clients.label')}</span>
    <div class="head">
      <h2 class="wide"><Dot text={t('clients.title')} /></h2>
    </div>
    <ul class="grid">
      {CLIENT_LOGOS.map((c) => (
        <li title={c.name}>
          {c.logo
            ? <Image src={c.logo} alt={c.name} width={180} height={180} densities={[1, 2]} />
            : <span>{c.name}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* White band: the logos have white backgrounds, so they sit directly on the page. */
  .clients { background: #fff; color: var(--bg); padding: 110px 0 90px; }
  .kicker { color: var(--pink); }
  .head { margin: 22px 0 48px; }
  h2 { font-size: var(--title-size); line-height: 0.95; }
  @media (max-width: 900px) { .head { margin-bottom: 32px; } }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 8px 16px; align-items: center; }
  li { aspect-ratio: 1; display: grid; place-items: center; transition: transform 0.25s; }
  li:hover { transform: scale(1.06); }
  li img { width: 100%; height: 100%; object-fit: contain; }
  li span { font-stretch: 125%; font-weight: 900; text-transform: uppercase; font-size: clamp(14px, 1.4vw, 20px); line-height: 1; text-align: center; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .clients { padding: 80px 0 64px; }
    .grid { gap: 0 10px; }
    li span { font-size: 13px; }
  }
</style>
