---
import { type Lang, useT } from '../i18n';

interface Props { lang: Lang }
const t = useT(Astro.props.lang);
---
<section class="about" id="about">
  <div class="wrap">
    <span class="mono kicker">{t('about.label')}</span>
    <div class="grid">
      <h2 class="wide">{t('about.title')}</h2>
      <div class="text">
        <p>{t('about.p1')}</p>
        <p class="manifesto">{t('about.p2')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about { padding: 130px 0 110px; }
  .kicker { color: var(--pink); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 22px; align-items: start; }
  h2 { font-size: clamp(40px, 5.6vw, 88px); line-height: 0.92; overflow-wrap: break-word; }
  .text { display: grid; gap: 28px; padding-top: 8px; }
  p { color: var(--fg2); font-size: 19px; max-width: 46ch; }
  .manifesto { color: var(--fg); font-size: clamp(22px, 2vw, 28px); line-height: 1.3; font-weight: 600; border-left: 4px solid var(--pink); padding-left: 22px; }
  @media (max-width: 900px) {
    .about { padding: 96px 0 80px; }
    .grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
