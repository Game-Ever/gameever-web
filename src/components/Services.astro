---
// Services as accordions: three blocks, all closed on load; each opens smoothly to show its list.
import Dot from './Dot.astro';
import { type Lang, useT, url } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const groups = t('services.groups');
---
<section class="services" id="services">
  <div class="wrap">
    <span class="mono kicker">{t('services.label')}</span>
    <div class="head">
      <h2 class="wide">{t('services.title').map((line) => <span><Dot text={line} /></span>)}</h2>
      <div class="aside">
        <p class="lines">{t('services.lines').map((line) => <span>{line}</span>)}</p>
      </div>
    </div>

    <div class="acc">
      {groups.map((g, i) => (
        <div class:list={['item', `area-${g.area}`]}>
          <h3>
            <button class="trigger" id={`svc-btn-${i}`} aria-expanded="false" aria-controls={`svc-panel-${i}`}>
              <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="name wide">{g.title}</span>
              <span class="count mono">{t('services.count', { n: g.items.length })}</span>
              <span class="icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="panel" id={`svc-panel-${i}`} role="region" aria-labelledby={`svc-btn-${i}`} inert>
            <div class="inner">
              <ul>{g.items.map((item) => <li>{item}</li>)}</ul>
              <a class="see" href={`${url(lang, "work")}?area=${g.area === 'coproduction' ? 'games' : g.area}`}>{t('services.see')} →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding: 70px 0 130px; }
  .kicker { color: var(--pink); }
  /* Same layout as Nosotros: title left, side block right, top-aligned. */
  .head { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 22px; align-items: start; }
  h2 { font-size: var(--title-size); line-height: 0.95; overflow-wrap: break-word; }
  h2 span { display: block; }

  .acc { margin-top: 64px; border-top: 1px solid var(--line); }
  .item { border-bottom: 1px solid var(--line); }
  .trigger { width: 100%; display: grid; grid-template-columns: 64px minmax(0, 1fr) auto 56px; align-items: center; gap: 16px; padding: 30px 0; background: none; border: 0; cursor: pointer; text-align: left; }
  .num { color: var(--mute); }
  .name { font-size: var(--subtitle-size); line-height: 1; overflow-wrap: break-word; transition: color 0.25s, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .count { color: var(--mute); }
  .trigger:hover .name, .item.open .name { color: var(--area); }
  .trigger:hover .name { transform: translateX(8px); }

  /* Plus that turns into a minus: the vertical bar rotates flat when the block is open. */
  .icon { position: relative; justify-self: end; width: 48px; height: 48px; border: 2px solid var(--line2); border-radius: 50%; transition: background 0.25s, border-color 0.25s, transform 0.35s; }
  .icon::before, .icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 16px; height: 2px; background: var(--fg); transform: translate(-50%, -50%); transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .trigger:hover .icon { border-color: var(--fg); }
  .item.open .icon { background: var(--area); border-color: var(--area); }
  .item.open .icon::after { transform: translate(-50%, -50%) rotate(0deg); }

  /* Smooth height animation without measuring: grid row goes from 0fr to 1fr. */
  .panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.45s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .item.open .panel { grid-template-rows: 1fr; }
  .inner { overflow: hidden; padding-left: 80px; }
  ul { list-style: none; padding: 0 0 8px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 32px; opacity: 0; transform: translateY(-8px); transition: opacity 0.3s, transform 0.4s; }
  .item.open ul { opacity: 1; transform: none; transition-delay: 0.1s; }
  li { display: flex; gap: 12px; align-items: baseline; font-size: var(--body-size); color: var(--fg2); }
  li::before { content: ''; flex: 0 0 auto; width: 8px; height: 8px; background: var(--area); transform: translateY(-2px); }
  .see { display: inline-block; margin: 24px 0 36px; font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: 14px; border-bottom: 2px solid var(--area); padding-bottom: 3px; }
  .see:hover { color: var(--area); }

  @media (max-width: 900px) {
    .services { padding: 56px 0 96px; }
    .head { grid-template-columns: 1fr; gap: 18px; }
    .acc { margin-top: 44px; }
    .trigger { grid-template-columns: minmax(0, 1fr) 44px; padding: 24px 0; }
    .num { display: none; }
    .count { display: none; }
    .icon { width: 40px; height: 40px; }
    .inner { padding-left: 0; }
    ul { grid-template-columns: 1fr; gap: 12px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.services .trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.item')!;
      const panel = item.querySelector<HTMLElement>('.panel')!;
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      item.classList.toggle('open', open);
      panel.inert = !open;
    });
  });
</script>
