---
import { type Lang, useT, SOCIAL } from '../i18n';

interface Props { lang: Lang }
const t = useT(Astro.props.lang);
---
<footer class="contact" id="contact">
  <div class="wrap">
    <span class="mono label">{t('contact.label')}</span>
    <h2 class="wide">{t('contact.title')} <em>{t('contact.titleEm')}</em></h2>
    <a class="mail" href="mailto:info@gameeverstudio.com">info@gameeverstudio.com</a>
    <div class="cols">
      <div><span class="mono">{t('contact.careers')}</span><a href="mailto:jobs@gameeverstudio.com">jobs@gameeverstudio.com</a></div>
      <div><span class="mono">{t('contact.studio')}</span>{t('contact.studioValue')}</div>
      <div><span class="mono">{t('contact.hours')}</span>{t('contact.hoursValue')}</div>
      <div><span class="mono">{t('contact.follow')}</span>
        {SOCIAL.map((s, i) => <>{i > 0 && ' · '}<a href={s.url} rel="me noopener" target="_blank">{s.label}</a></>)}
      </div>
    </div>
    <div class="foot"><span>© {new Date().getFullYear()} Game Ever S.A.</span><span>{t('footer.tagline')}</span></div>
  </div>
</footer>

<style>
  .contact { background: var(--paper); color: var(--bg); padding: 130px 0 40px; }
  .label { color: var(--paper-mute); }
  h2 { font-size: clamp(36px, 10vw, 170px); line-height: 0.86; margin-top: 20px; }
  em { font-style: normal; color: var(--pink); }
  .mail { display: inline-block; margin-top: 40px; font-size: clamp(22px, 3.4vw, 46px); font-weight: 800; font-stretch: 115%; border-bottom: 4px solid var(--pink); padding-bottom: 4px; overflow-wrap: anywhere; }
  .mail:hover { color: var(--pink); }
  .cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 100px; border-top: 1px solid #cfccc5; padding-top: 24px; font-size: 15px; }
  .cols div { min-width: 0; overflow-wrap: anywhere; }
  .cols .mono { display: block; color: var(--paper-mute); margin-bottom: 6px; }
  .cols a:hover { color: var(--pink); }
  .foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 72px; font-size: 13px; color: var(--paper-mute); }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr 1fr; } }
</style>
