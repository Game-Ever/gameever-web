---
import { type Lang, useT, SOCIAL } from '../i18n';
import Legal from './Legal.astro';

interface Props { lang: Lang }
const t = useT(Astro.props.lang);

// Form delivery: set PUBLIC_FORM_ENDPOINT (and PUBLIC_FORM_KEY for services like Web3Forms) at build
// time to post the form to a form service. Without them, submitting opens the visitor's email app
// with the message ready to send to info@, so the form always works.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const formKey = import.meta.env.PUBLIC_FORM_KEY ?? '';
const msgs = { sending: t('form.sending'), send: t('form.send'), ok: t('form.ok'), error: t('form.error'), mailto: t('form.mailto'), subject: t('form.subject') };
---
<footer class="contact" id="contact">
  <div class="band">
  <!-- Decorative pixels on the 32px grid: two blink like a cursor, two "walk" one cell at a time. -->
  <div class="pixels" aria-hidden="true">
    <i style="--x:3;--y:1"></i>
    <i class="dim" style="--x:2;--y:2;--delay:-1.6s"></i>
    <i class="walk" style="--x:9;--y:1"></i>
    <i class="walk dim" style="--x:9;--y:1;--delay:-0.6s"></i>
    <i style="--x:36;--y:2;--dur:2.6s"></i>
    <i class="dim" style="--x:37;--y:1;--dur:2.6s;--delay:-1.3s"></i>
  </div>
  <div class="wrap top">
    <div class="pitch">
      <span class="mono label">{t('contact.label')}</span>
      <h2 class="wide"><span>{t('contact.title')}</span> <em>{t('contact.titleEm')}</em></h2>
    </div>

    <form class="form" novalidate data-endpoint={endpoint} data-key={formKey} data-msgs={JSON.stringify(msgs)}>
      <h3 class="wide">{t('form.title')}</h3>
      <div class="row">
        <label><span>{t('form.name')}</span><input name="name" autocomplete="name" required /></label>
        <label><span>{t('form.email')}</span><input name="email" type="email" autocomplete="email" required /></label>
      </div>
      <label><span>{t('form.message')}</span><textarea name="message" rows="5" required></textarea></label>
      <!-- Honeypot: real visitors never see or fill this field -->
      <input class="hp" type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit">{t('form.send')} <span aria-hidden="true">→</span></button>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
  </div>

  <!-- Site footer: black strip under the pink band. -->
  <div class="site-foot"><div class="wrap">
    <div class="cols">
      <div><span class="mono">{t('contact.careers')}</span><a href="mailto:jobs@gameeverstudio.com">jobs@gameeverstudio.com</a></div>
      <div><span class="mono">{t('contact.studio')}</span>{t('contact.studioValue')}</div>
      <div><span class="mono">{t('contact.hours')}</span>{t('contact.hoursValue')}</div>
      <div><span class="mono">{t('contact.follow')}</span>
        <ul class="social">
          {SOCIAL.map((s) => (
            <li><a href={s.url} rel="me noopener" target="_blank" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d={s.icon} /></svg>
            </a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="legal-row"><Legal lang={Astro.props.lang} /></div>
  </div></div>
</footer>

<style>
  /* Closing band in brand pink, split in two and top-aligned: the closing phrase on the left, the form on the right,
     drawn directly on the pink (ink lines and text, ink button) so the band reads as one block. */
  .band { position: relative; overflow: hidden; background: var(--pink); color: var(--bg); padding: 120px 0 112px; }
  /* 32px grid over the pink, anchored to the band's top-left so the pixels sit exactly in its cells. */
  .band::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(0, 0, 0, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 0, 0, 0.07) 1px, transparent 1px); background-size: 32px 32px; pointer-events: none; }
  .band > .wrap { position: relative; z-index: 1; }
  .pixels i { position: absolute; left: calc(var(--x) * 32px); top: calc(var(--y) * 32px); width: 32px; height: 32px; background: #fff; animation: blink var(--dur, 3.2s) steps(1, end) infinite var(--delay, 0s); }
  .pixels i.dim { background: rgba(255, 255, 255, 0.55); }
  /* The walker hops 8 cells to the right, one cell per step, then starts over. */
  .pixels i.walk { animation: walk 4.8s steps(8, end) infinite var(--delay, 0s); }
  @keyframes blink { 0%, 62% { opacity: 1; } 63%, 100% { opacity: 0; } }
  @keyframes walk { from { transform: translateX(0); } to { transform: translateX(256px); } }
  .top { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: start; }
  .label { color: var(--bg); }
  /* Same size as every section title (--title-size). */
  h2 { font-size: var(--title-size); line-height: 0.95; margin-top: 20px; color: #fff; overflow-wrap: break-word; }
  h2 span { display: block; }
  em { font-style: normal; color: var(--bg); display: block; }

  /* Pushed down by the kicker's height so "Empecemos." lines up with the big title. */
  .form { color: var(--bg); display: grid; gap: 26px; padding-top: 47px; }
  .form h3 { font-size: var(--subtitle-size); line-height: 1; color: #fff; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .form label { display: grid; gap: 8px; }
  .form label > span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bg); }
  input, textarea { width: 100%; background: transparent; border: 0; border-bottom: 2px solid rgba(13, 13, 15, 0.45); color: var(--bg); font: 600 18px var(--sans); padding: 8px 0; border-radius: 0; outline: none; transition: border-color 0.2s; }
  textarea { resize: vertical; min-height: 110px; border: 2px solid rgba(13, 13, 15, 0.45); padding: 12px; }
  input:focus, textarea:focus { border-color: var(--bg); }
  /* Invalid fields: white line, which stands out from the ink ones on the pink background. */
  .form :global(.invalid) { border-color: #fff; }
  .form :focus-visible { outline-color: var(--bg); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  button { justify-self: start; display: inline-flex; gap: 12px; align-items: center; background: var(--bg); color: #fff; border: 0; padding: 16px 26px; font-weight: 800; font-stretch: 118%; text-transform: uppercase; font-size: 15px; cursor: pointer; transition: background 0.2s, color 0.2s; }
  button:hover { background: #fff; color: var(--bg); }
  button:disabled { opacity: 0.6; cursor: wait; }
  .status { min-height: 1.4em; font-size: 15px; font-weight: 600; color: var(--bg); }
  .status:empty { display: none; }

  /* Black footer strip: light text, tight bottom margin. */
  .site-foot { background: var(--bg); color: var(--fg); padding: 40px 0 20px; }
  .cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; font-size: 15px; }
  .cols div { min-width: 0; overflow-wrap: anywhere; }
  .cols .mono { display: block; color: var(--fg2); margin-bottom: 6px; }
  .cols a { text-decoration: underline; text-underline-offset: 3px; transition: color 0.2s; }
  .cols a:hover { color: var(--pink); }
  .social { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line2); transition: background 0.2s, border-color 0.2s, transform 0.2s; }
  .social a:hover { background: var(--pink); border-color: var(--pink); transform: translateY(-2px); }
  .social svg { width: 18px; height: 18px; fill: var(--fg); }
  .legal-row { margin-top: 32px; }
  .pitch :focus-visible { outline-color: var(--bg); }

  @media (max-width: 1000px) { .top { grid-template-columns: 1fr; gap: 40px; } .form { padding-top: 0; } }
  @media (max-width: 760px) {
    /* Leaves the first three grid rows free for the pixels above the "Contacto" label. */
    .band { padding: 112px 0 72px; }
    .form { padding-top: 0; }
    .row { grid-template-columns: 1fr; }
    .cols { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact .form');
  if (form) {
    const msgs = JSON.parse(form.dataset.msgs!);
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
    fields.forEach((f) => f.addEventListener('input', () => f.classList.remove('invalid')));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bad = fields.filter((f) => !f.checkValidity());
      fields.forEach((f) => f.classList.toggle('invalid', bad.includes(f)));
      if (bad.length) { bad[0].focus(); return; }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.botcheck) return; // bot filled the honeypot
      delete data.botcheck;
      const subject = `${msgs.subject} — ${data.name}`;

      // No form service configured: hand the message to the visitor's email app.
      if (!form.dataset.endpoint) {
        const body = `${data.message}\n\n—\n${data.name}\n${data.email}`;
        location.href = `mailto:info@gameeverstudio.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = msgs.mailto;
        return;
      }

      button.disabled = true;
      button.firstChild!.textContent = `${msgs.sending} `;
      try {
        const res = await fetch(form.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...data, subject, from_name: 'gameeverstudio.com', ...(form.dataset.key ? { access_key: form.dataset.key } : {}) }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = msgs.ok;
      } catch {
        status.textContent = msgs.error;
      } finally {
        button.disabled = false;
        button.firstChild!.textContent = `${msgs.send} `;
      }
    });
  }
</script>
