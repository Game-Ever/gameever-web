---
import { type Lang, useT, REEL_ID } from '../i18n';

interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const src = `https://www.youtube-nocookie.com/embed/${REEL_ID}?autoplay=1&mute=1&loop=1&playlist=${REEL_ID}&controls=0&rel=0&playsinline=1&modestbranding=1&iv_load_policy=3&disablekb=1&enablejsapi=1`;
---
<section class="reel" aria-label={t('reel.label')}
  data-i18n={JSON.stringify({ pause: t('reel.pause'), play: t('reel.play'), mute: t('reel.mute'), unmute: t('reel.unmute') })}>
  <img class="poster" src={`https://i.ytimg.com/vi/${REEL_ID}/maxresdefault.jpg`} alt="" fetchpriority="high" />
  <iframe class="yt" title={t('reel.label')} allow="autoplay; encrypted-media" tabindex="-1" data-src={src}></iframe>
  <!-- Cinema bars: same height top and bottom; the bottom one hides the logo burned into the reel. -->
  <i class="bar bar-top" aria-hidden="true"></i>
  <i class="bar bar-bottom" aria-hidden="true"></i>
  <!-- Tagline over the video, in the same layout as the sections: big text left, side block right. -->
  <div class="overlay">
    <div class="wrap grid">
      <h1 class="wide">{t('statement.lines').map((line) => <span>{line}</span>)}</h1>
      <div class="aside"><p>{t('statement.body')}</p></div>
    </div>
  </div>
  <div class="controls">
    <button class="c-play" aria-label={t('reel.pause')}><svg viewBox="0 0 24 24"><path d="M8 5v14M16 5v14" /></svg></button>
    <button class="c-mute" aria-label={t('reel.unmute')}><svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M17 9l4 6M21 9l-4 6" /></svg></button>
    <button class="c-restart" aria-label={t('reel.restart')}><svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 4v4h4" /></svg></button>
  </div>
  <a class="scroll mono" href="#about">{t('reel.scroll')} ↓</a>
</section>

<style>
  /* --band: height of the black bars. The video is 16:9 scaled to cover, so its height is max(56.25vw, reel height);
     the logo burned into the reel starts at ~86% of the video's height, so the bar covers the bottom 14% of the video
     (plus whatever is cropped). Percentages here resolve against the reel's height in every child that uses it. */
  .reel { --band: max(72px, calc(50% - 0.36 * max(56.25vw, 100%))); position: relative; height: 100svh; min-height: 520px; overflow: hidden; background: #000; }
  .bar { position: absolute; left: 0; right: 0; height: var(--band); background: #000; z-index: 2; pointer-events: none; }
  .bar-top { top: 0; }
  .bar-bottom { bottom: 0; }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .yt { position: absolute; top: 50%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100%; min-width: 177.78svh; transform: translate(-50%, -50%); border: 0; pointer-events: none; opacity: 0; transition: opacity 1.2s; }
  .yt.on { opacity: 1; }
  /* Fade in when playback starts, but hide instantly on pause so YouTube's overlay never shows. */
  .yt:not(.on) { transition: none; }
  /* Darker lower half so the tagline reads over any frame of the reel. */
  .reel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, transparent 22%, transparent 40%, rgba(13, 13, 15, 0.88) 100%); pointer-events: none; z-index: 1; }
  /* Tagline sits just above the bottom bar; controls and the scroll link are centred inside it. */
  .overlay { position: absolute; left: 0; right: 0; bottom: calc(var(--band) + 40px); z-index: 3; color: #fff; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: end; }
  /* Hero tagline: capped at 88px, one phrase per line. */
  h1 { font-size: clamp(34px, 6vw, 88px); line-height: 0.9; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35); }
  h1 span { display: block; white-space: nowrap; }
  .overlay .aside { margin-bottom: 10px; }
  .overlay .aside p { color: #fff; font-weight: 500; }
  .controls { position: absolute; left: 50%; bottom: max(10px, calc((var(--band) - 52px) / 2)); transform: translateX(-50%); display: flex; gap: 10px; z-index: 3; }
  .controls button { width: 52px; height: 52px; border: 2px solid rgba(255, 255, 255, 0.75); background: rgba(0, 0, 0, 0.25); backdrop-filter: blur(6px); cursor: pointer; display: grid; place-items: center; transition: background 0.2s, border-color 0.2s; }
  .controls button:hover { background: var(--pink); border-color: var(--pink); }
  .controls :global(svg) { width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 2; }
  .scroll { position: absolute; bottom: calc(var(--band) / 2 - 0.6em); right: var(--gutter); z-index: 3; color: rgba(255, 255, 255, 0.8); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 760px) {
    .scroll { display: none; }
    .overlay { bottom: calc(var(--band) + 28px); }
    .grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

<script>
  const ICONS = {
    pause: '<svg viewBox="0 0 24 24"><path d="M8 5v14M16 5v14"/></svg>',
    play: '<svg viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"/></svg>',
    muted: '<svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 9l4 6M21 9l-4 6"/></svg>',
    sound: '<svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 8a5 5 0 0 1 0 8M19.5 5.5a9 9 0 0 1 0 13"/></svg>',
  };
  const reel = document.querySelector<HTMLElement>('.reel');
  if (reel) {
    const i18n = JSON.parse(reel.dataset.i18n!);
    const yt = reel.querySelector<HTMLIFrameElement>('.yt')!;
    const btnPlay = reel.querySelector<HTMLButtonElement>('.c-play')!;
    const btnMute = reel.querySelector<HTMLButtonElement>('.c-mute')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let playing = false;
    let muted = true;
    const cmd = (func: string, args: unknown[] = []) =>
      yt.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args }), '*');
    const setPlay = (p: boolean) => {
      playing = p;
      btnPlay.innerHTML = p ? ICONS.pause : ICONS.play;
      btnPlay.setAttribute('aria-label', p ? i18n.pause : i18n.play);
    };
    // The video is only shown while it is actually playing. When paused, buffering at start or blocked
    // from autoplaying (some phones), our poster image stays on top, so YouTube's own overlay
    // (prev / play / next buttons) is never visible.
    let visible = false;
    const show = (on: boolean) => { visible = on; yt.classList.toggle('on', on); };
    addEventListener('message', (e) => {
      if (e.source !== yt.contentWindow || typeof e.data !== 'string') return;
      let data: { event?: string; info?: unknown };
      try { data = JSON.parse(e.data); } catch { return; }
      const state = data.event === 'onStateChange' ? data.info
        : data.event === 'infoDelivery' ? (data.info as { playerState?: number } | undefined)?.playerState
        : undefined;
      if (typeof state !== 'number') return;
      // 1 = playing, 3 = buffering (keep the current view to avoid flicker), anything else = hide.
      show(state === 1 || (state === 3 && visible));
      setPlay(state === 1 || state === 3);
    });
    const load = () => {
      yt.src = `${yt.dataset.src}&origin=${encodeURIComponent(location.origin)}`;
      // Ask the player to report its state changes to this page.
      yt.addEventListener('load', () => yt.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 'reel', channel: 'widget' }), '*'), { once: true });
      setPlay(true);
    };
    if (reduce) setPlay(false); else load();
    btnPlay.addEventListener('click', () => {
      if (!yt.getAttribute('src')) return load();
      cmd(playing ? 'pauseVideo' : 'playVideo');
      setPlay(!playing);
    });
    btnMute.addEventListener('click', () => {
      muted = !muted;
      cmd(muted ? 'mute' : 'unMute');
      btnMute.innerHTML = muted ? ICONS.muted : ICONS.sound;
      btnMute.setAttribute('aria-label', muted ? i18n.unmute : i18n.mute);
    });
    reel.querySelector('.c-restart')!.addEventListener('click', () => {
      if (!yt.getAttribute('src')) return load();
      cmd('seekTo', [0, true]);
      cmd('playVideo');
      setPlay(true);
    });
  }
</script>
