---
// "Qué hacemos": the two worlds (games and animation), each card jumping to the matching projects.
import { Image } from 'astro:assets';
import { type Lang, type Project, useT } from '../i18n';

interface Props { lang: Lang; projects: Project[] }
const { lang, projects } = Astro.props;
const t = useT(lang);
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
const landscape = (id: string) => byId[id].data.gallery.find((g) => g.width > g.height * 1.2) ?? byId[id].data.cover;
const groups = t('services.groups');
const cards = [
  { title: t('worlds.games'), cta: t('worlds.gamesCta'), jump: groups[0].jump, img: landscape('juanito-arcade-mayhem') },
  { title: t('worlds.anim'), cta: t('worlds.animCta'), jump: groups[1].jump, img: byId['lit-killah-bizarrap-flexin'].data.cover },
];
---
<section class="worlds" id="what-we-do">
  <div class="wrap">
    <span class="mono kicker">{t('worlds.label')}</span>
    <div class="head">
      <h2 class="wide">{t('worlds.title')}</h2>
      <div class="text">
        <p class="lead">{t('worlds.p1')}</p>
        <p>{t('worlds.p2')}</p>
      </div>
    </div>
    <div class="cards">
      {cards.map((c) => (
        <a class="card" href={`?sv=${c.jump}#work`} data-jump-service={c.jump}>
          <Image src={c.img} alt="" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 50vw" />
          <span class="title wide">{c.title}</span>
          <span class="cta mono">{c.cta} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .worlds { padding: 40px 0 130px; }
  .kicker { color: var(--pink); }
  .head { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 22px; align-items: start; }
  h2 { font-size: clamp(36px, 4.6vw, 72px); line-height: 0.95; overflow-wrap: break-word; }
  .text { display: grid; gap: 18px; padding-top: 8px; }
  p { color: var(--fg2); font-size: 18px; max-width: 46ch; }
  .lead { color: var(--fg); font-size: clamp(20px, 1.8vw, 24px); line-height: 1.35; font-weight: 600; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 64px; }
  .card { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg2); isolation: isolate; }
  .card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); z-index: -1; }
  .card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(13, 13, 15, 0.85) 100%); z-index: -1; }
  .title { position: absolute; left: 28px; bottom: 56px; font-size: clamp(32px, 4.4vw, 68px); line-height: 0.9; transition: color 0.25s; }
  .cta { position: absolute; left: 28px; bottom: 26px; color: var(--fg2); }
  .card:hover img { transform: scale(1.05); }
  .card:hover .title { color: var(--pink); }
  @media (max-width: 900px) {
    .head, .cards { grid-template-columns: 1fr; gap: 28px; }
    .cards { margin-top: 40px; gap: 14px; }
    .worlds { padding-bottom: 96px; }
    .title { left: 18px; bottom: 44px; }
    .cta { left: 18px; bottom: 18px; }
  }
</style>
