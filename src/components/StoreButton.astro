---
// Link button with the store's logo: "Disponible en / Google Play", "En Poki / Jugar online", "En el navegador / Jugar online", "Sitio web / ...".
// The store is recognized from the URL, so project files keep plain { label, url } links.
import { type Lang, useT } from '../i18n';

interface Props { lang: Lang; label: string; url: string; webGame?: boolean }
const { lang, label, url, webGame = false } = Astro.props;
const t = useT(lang);
const host = new URL(url).hostname.replace(/^www\./, '');

// Brand marks from Simple Icons (CC0); the two generic ones are drawn here.
const ICONS = {
