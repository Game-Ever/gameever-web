  steam: 'M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z',
  gog: 'M7.15 15.24H4.36a.4.4 0 0 0-.4.4v2c0 .21.18.4.4.4h2.8v1.32h-3.5c-.56 0-1.02-.46-1.02-1.03v-3.39c0-.56.46-1.02 1.03-1.02h3.48v1.32zM8.16 11.54c0 .58-.47 1.05-1.05 1.05H2.63v-1.35h3.78a.4.4 0 0 0 .4-.4V6.39a.4.4 0 0 0-.4-.4H4.39a.4.4 0 0 0-.41.4v2.02c0 .23.18.4.4.4H6v1.35H3.68c-.58 0-1.05-.46-1.05-1.04V5.68c0-.57.47-1.04 1.05-1.04H7.1c.58 0 1.05.47 1.05 1.04v5.86zM21.36 19.36h-1.32v-4.12h-.93a.4.4 0 0 0-.4.4v3.72h-1.33v-4.12h-.93a.4.4 0 0 0-.4.4v3.72h-1.33v-4.42c0-.56.46-1.02 1.03-1.02h5.61v5.44zM21.37 11.54c0 .58-.47 1.05-1.05 1.05h-4.48v-1.35h3.78a.4.4 0 0 0 .4-.4V6.39a.4.4 0 0 0-.4-.4h-2.03a.4.4 0 0 0-.4.4v2.02c0 .23.18.4.4.4h1.62v1.35H16.9c-.58 0-1.05-.46-1.05-1.04V5.68c0-.57.47-1.04 1.05-1.04h3.43c.58 0 1.05.47 1.05 1.04v5.86zM13.72 4.64h-3.44c-.58 0-1.04.47-1.04 1.04v3.44c0 .58.46 1.04 1.04 1.04h3.44c.57 0 1.04-.46 1.04-1.04V5.68c0-.57-.47-1.04-1.04-1.04m-.3 1.75v2.02a.4.4 0 0 1-.4.4h-2.03a.4.4 0 0 1-.4-.4V6.4c0-.22.17-.4.4-.4H13c.23 0 .4.18.4.4zM12.63 13.92H9.24c-.57 0-1.03.46-1.03 1.02v3.39c0 .57.46 1.03 1.03 1.03h3.39c.57 0 1.03-.46 1.03-1.03v-3.39c0-.56-.46-1.02-1.03-1.02m-.3 1.72v2a.4.4 0 0 1-.4.4v-.01H9.94a.4.4 0 0 1-.4-.4v-1.99c0-.22.18-.4.4-.4h2c.22 0 .4.18.4.4zM23.49 1.1a1.74 1.74 0 0 0-1.24-.52H1.75A1.74 1.74 0 0 0 0 2.33v19.34a1.74 1.74 0 0 0 1.75 1.75h20.5A1.74 1.74 0 0 0 24 21.67V2.33c0-.48-.2-.92-.51-1.24m0 20.58a1.23 1.23 0 0 1-1.24 1.24H1.75A1.23 1.23 0 0 1 .5 21.67V2.33a1.23 1.23 0 0 1 1.24-1.24h20.5a1.24 1.24 0 0 1 1.24 1.24v19.34z',
  // Monitor with a play triangle: browser games on PC.
  web: 'M2 3h20a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-8v2h3v2H7v-2h3v-2H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm1 2v11h18V5H3zm7 2.2 5.2 3.3L10 13.8V7.2z',
  // Globe: any other website.
  site: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-2.9a15.6 15.6 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16zM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.3 6.7 8 8zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z',
} as const;

const STORES: { match: RegExp; icon: keyof typeof ICONS; name: string }[] = [
  { match: /(^|\.)apps\.apple\.com$|(^|\.)itunes\.apple\.com$/, icon: 'apple', name: 'App Store' },
  { match: /(^|\.)play\.google\.com$/, icon: 'googleplay', name: 'Google Play' },
  { match: /(^|\.)steampowered\.com$|(^|\.)steamcommunity\.com$/, icon: 'steam', name: 'Steam' },
  { match: /(^|\.)gog\.com$/, icon: 'gog', name: 'GOG' },
];
// Browser game portals, recognized from the URL. A game on any other site is marked with `webGame: true`.
const WEB_GAMES: Record<string, string> = { 'poki.com': 'Poki', 'crazygames.com': 'CrazyGames', 'itch.io': 'itch.io', 'newgrounds.com': 'Newgrounds' };

const store = STORES.find((s) => s.match.test(host));
const portal = Object.entries(WEB_GAMES).find(([h]) => host === h || host.endsWith(`.${h}`))?.[1];
// A label naming something other than the store (e.g. "Zoo Animals (App Store)") keeps that name, with the store as caption.
const own = store ? label.replace(/\s*\(.*\)\s*$/, '').trim() : '';
const [icon, caption, name] = store
  ? own && own.toLowerCase() !== store.name.toLowerCase() ? [store.icon, store.name, own] : [store.icon, t('store.available'), store.name]
  : portal || webGame ? ['web', portal ? `${t('store.on')} ${portal}` : t('store.browser'), t('store.playOnline')] : ['site', t('store.website'), label];
---
<a class="store" href={url} target="_blank" rel="noopener" aria-label={`${caption} ${name}`}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[icon as keyof typeof ICONS]} /></svg>
  <span class="txt"><span class="cap">{caption}</span><span class="name">{name}</span></span>
</a>

<style>
  /* Same outline as the site's buttons, with the store's logo and a two-line label. */
  .store { display: inline-flex; align-items: center; gap: 12px; min-height: 60px; padding: 8px 22px 8px 18px; border: 2px solid var(--fg); color: var(--fg); transition: background 0.2s, color 0.2s; }
  .store:hover { background: var(--fg); color: var(--bg); }
  .store svg { width: 28px; height: 28px; fill: currentColor; flex: none; }
  .txt { display: flex; flex-direction: column; line-height: 1.05; }
  .cap { font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.75; }
  .name { font-weight: 800; font-stretch: 118%; text-transform: uppercase; font-size: 16px; margin-top: 3px; white-space: nowrap; }
</style>
