---
import { type Lang, useT } from '../i18n';

interface Props { lang: Lang }
const t = useT(Astro.props.lang);
---
<section class="statement" id="statement">
  <i class="px" style="top:56px;right:12%"></i><i class="px" style="top:88px;right:calc(12% + 32px);opacity:.6"></i>
  <!-- Same pattern as every section: big text on the left, side block on the right. -->
  <div class="wrap grid">
    <h2 class="wide">{t('statement.lines').map((line) => <span>{line}</span>)}</h2>
    <div class="aside on-pink"><p>{t('statement.body')}</p></div>
  </div>
</section>

<style>
  .statement { position: relative; background: var(--pink); color: #fff; padding: 120px 0 110px; overflow: hidden; }
  .statement::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(0, 0, 0, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 0, 0, 0.07) 1px, transparent 1px); background-size: 32px 32px; pointer-events: none; }
  .px { position: absolute; background: #fff; width: 32px; height: 32px; }
  .grid { position: relative; display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: end; }
  /* The brand statement stays larger than section titles, capped at 88px; each phrase stays on one line.
     Longest line ("WE CREATE." ≈ 8.3× the font size) fits from 320px phones up. */
  h2 { font-size: clamp(34px, 6vw, 88px); line-height: 0.9; }
  h2 span { display: block; white-space: nowrap; opacity: 0.28; transition: opacity 0.25s linear; }
  .aside { margin-bottom: 10px; }
  .aside p { font-weight: 500; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 760px) { .statement { padding: 88px 0 80px; } }
  @media (prefers-reduced-motion: reduce) { h2 span { opacity: 1; } }
</style>

<script>
  // Lines light up as they scroll into the middle of the screen.
  const lines = [...document.querySelectorAll<HTMLElement>('.statement h2 span')];
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const light = () => {
      const vh = innerHeight;
      for (const l of lines) {
        const p = 1 - (l.getBoundingClientRect().top - vh * 0.35) / (vh * 0.4);
        l.style.opacity = Math.max(0.28, Math.min(1, p)).toFixed(2);
      }
    };
    addEventListener('scroll', () => requestAnimationFrame(light), { passive: true });
    light();
  }
</script>
