---
// Lightweight YouTube embed: shows the thumbnail and only loads the player on click.
interface Props { id: string; title: string; playLabel: string; caption?: string }
const { id, title, playLabel, caption } = Astro.props;
---
<figure class="yt-lite">
  <button class="frame" data-id={id} data-title={title} aria-label={`${playLabel}: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" /></svg></span>
  </button>
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .yt-lite { margin: 0; }
  .frame { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; border: 0; padding: 0; cursor: pointer; overflow: hidden; }
  .frame img { width: 100%; height: 100%; object-fit: cover; opacity: 0.75; transition: opacity 0.3s, transform 0.6s; }
  .frame:hover img { opacity: 0.9; transform: scale(1.02); }
  .play { position: absolute; inset: 0; display: grid; place-items: center; }
  .play svg { width: 72px; height: 72px; padding: 22px; background: var(--pink); fill: #fff; }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { color: var(--mute); margin-top: 10px; }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.yt-lite .frame');
    if (!btn || btn.querySelector('iframe')) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0`;
    iframe.title = btn.dataset.title ?? '';
    iframe.allow = 'autoplay; encrypted-media; fullscreen';
    iframe.allowFullscreen = true;
    btn.replaceChildren(iframe);
  });
</script>
