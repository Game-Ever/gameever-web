---
import { Image } from 'astro:assets';
import { type Lang, type Project, useT, url, clientName } from '../i18n';
import { AREAS, AREA_KEYS, areasOf } from '../data/taxonomy';
import { WORLD_PROJECTS } from '../data/worlds';

// variant "home": a short selection (first HOME_COUNT in Featured order, minus the projects already shown in
// the "Qué hacemos" cards) with a link to the full list.
// variant "full": every project, with area tabs (Todos / Videojuegos / Animación / Co-producción),
// search and sort, all kept in the URL (?area=games&q=…&sort=newest) so links can be shared.
interface Props { lang: Lang; projects: Project[]; variant?: 'home' | 'full' }
const { lang, variant = 'full' } = Astro.props;
const HOME_COUNT = 6;
const projects = variant === 'home'
  ? Astro.props.projects.filter((p) => !WORLD_PROJECTS.includes(p.id)).slice(0, HOME_COUNT)
  : Astro.props.projects;
const full = variant === 'full';
const Heading = full ? 'h1' : 'h2';
const t = useT(lang);

const areaOf = new Map(projects.map((p) => [p.id, areasOf(p.data.services, p.data.platforms)]));
const tabs = [
  { key: '', label: t('work.allAreas'), n: projects.length },
  ...AREA_KEYS.map((k) => ({ key: k, label: AREAS[k][lang], n: projects.filter((p) => areaOf.get(p.id)!.includes(k)).length })),
];
const i18n = { count: t('work.count'), showing: t('work.showing') };
---
<section class="work" id="work" data-i18n={JSON.stringify(i18n)}>
  <div class="wrap">
    <span class="mono kicker">{t('work.label')}</span>
    <div class="work-head">
      <Heading class="wide">{full ? t('work.allTitle') : t('work.title')}</Heading>
      {full && <div class="aside on-pink"><p class="lines">{t('work.lines').map((line) => <span>{line}</span>)}</p></div>}
    </div>

    {full && (
      <div class="toolbar">
        <div class="tabs" role="group" aria-label={t('work.label')}>
          {tabs.map((tab) => (
            <button class="tab" data-area={tab.key} aria-pressed={tab.key === '' ? 'true' : 'false'}>
              {tab.label} <span class="n">{tab.n}</span>
            </button>
          ))}
        </div>
        <div class="tools">
          <label class="search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
            <span class="sr-only">{t('work.search')}</span>
            <input type="search" name="q" placeholder={t('work.search')} autocomplete="off" />
          </label>
          <select class="sort" aria-label={t('work.sort')}>
            <option value="featured">{t('work.sort.featured')}</option>
            <option value="newest">{t('work.sort.newest')}</option>
            <option value="az">{t('work.sort.az')}</option>
          </select>
        </div>
      </div>
    )}
    {full && <span class="count mono" aria-live="polite">{t('work.count', { n: projects.length })}</span>}

    <div class="wall">
      {projects.map((p, i) => (
        <a
          class="card"
          href={url(lang, `work/${p.id}`)}
          data-title={p.data.title}
          data-client={p.data.client}
          data-year={p.data.year}
          data-order={i}
          data-area={areaOf.get(p.id)!.join(' ')}
        >
          <div class="img"><Image src={p.data.cover} alt="" widths={[320, 480, 640, 960]} sizes="(max-width: 1000px) 50vw, 430px" loading={i < 6 ? "eager" : "lazy"} /></div>
          <h3>{p.data.title}</h3>
          <span class="meta mono">{clientName(p.data.client, lang)} · {p.data.years ?? p.data.year}</span>
        </a>
      ))}
    </div>
    {full
      ? <p class="empty" hidden>{t('work.empty')} <button class="clear-all">{t('work.emptyClear')}</button></p>
      : <a class="all" href={url(lang, 'work')}>{t('work.all')} <span aria-hidden="true">→</span></a>}
  </div>
</section>

<style>
  .work { padding: 110px 0 120px; background: linear-gradient(180deg, var(--pink-d) 0, var(--bg) 420px); }
  .kicker { color: #fff; opacity: 0.85; }
  .work-head { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; margin: 22px 0 36px; }
  .work-head > * { min-width: 0; }
  .work-head :is(h1, h2) { font-size: var(--title-size); line-height: 0.95; overflow-wrap: break-word; }

  /* Toolbar: area tabs on the left, search and sort on the right; sticks under the header. */
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; position: sticky; top: var(--header-h); z-index: 20; padding: 14px 0; background: linear-gradient(var(--bg) 75%, transparent); }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .tab { display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 18px; border: 2px solid rgba(255, 255, 255, 0.35); background: none; cursor: pointer; font-weight: 800; font-stretch: 118%; text-transform: uppercase; font-size: 14px; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .tab:hover { border-color: var(--fg); }
  .tab[aria-pressed='true'] { background: var(--pink); border-color: var(--pink); color: #fff; }
  .n { font-family: var(--mono); font-size: 11px; font-weight: 400; opacity: 0.75; }
  .tools { display: flex; gap: 8px; }
  .search { display: flex; align-items: center; gap: 10px; border: 2px solid rgba(255, 255, 255, 0.35); padding: 0 14px; height: 46px; width: 280px; }
  .search input { flex: 1; min-width: 0; background: none; border: 0; color: var(--fg); font: 500 16px var(--sans); outline: none; }
  .search input::placeholder { color: rgba(255, 255, 255, 0.55); }
  .search:focus-within { border-color: var(--pink); }
  .sort { height: 46px; border: 2px solid rgba(255, 255, 255, 0.35); background: var(--bg); color: var(--fg); padding: 0 12px; font: 700 14px var(--sans); text-transform: uppercase; cursor: pointer; }
  .count { display: block; color: rgba(255, 255, 255, 0.6); margin: 10px 0 26px; }

  .wall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 28px; padding-bottom: 40px; }
  .card { display: flex; flex-direction: column; gap: 12px; animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { opacity: 0; translate: 0 30px; } to { opacity: 1; translate: 0 0; } }
  /* Landscape thumbnails cropped from the square key art; faces sit in the upper half, so bias the crop up. */
  .img { position: relative; aspect-ratio: var(--card-ratio, 4 / 3); overflow: hidden; background: var(--bg2); }
  .img img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s; filter: saturate(0.9); }
  .img::after { content: ''; position: absolute; right: 0; bottom: 0; width: 28px; height: 28px; background: var(--pink); transform: scale(0); transform-origin: bottom right; transition: transform 0.25s; }
  .card h3 { font-size: clamp(18px, 1.8vw, 26px); line-height: 1.05; overflow-wrap: break-word; font-stretch: 125%; font-weight: 800; text-transform: uppercase; transition: color 0.25s; }
  .meta { color: var(--mute); margin-top: -6px; }
  @media (hover: hover) {
    .card:hover img { transform: scale(1.06); filter: saturate(1.15); }
    .card:hover .img::after { transform: scale(1); }
    .card:hover h3 { color: var(--pink); }
  }
  .card:focus-visible h3 { color: var(--pink); }
  .all { display: inline-flex; gap: 12px; align-items: center; font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: 15px; border: 2px solid var(--fg); padding: 16px 24px; transition: background 0.2s, color 0.2s; }
  .all:hover { background: var(--fg); color: var(--bg); }
  .empty { text-align: center; padding: 80px 0; color: var(--mute); }
  .empty button { background: none; border: 0; color: var(--fg); text-decoration: underline; cursor: pointer; font-weight: 700; }

  @media (max-width: 1000px) {
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 16px; }
    .tools { width: 100%; min-width: 0; }
    .search { flex: 1; width: auto; min-width: 0; }
    .sort { flex: 0 0 auto; max-width: 46%; }
  }
  @media (max-width: 760px) {
    .work { padding-top: 80px; }
    .work-head { grid-template-columns: 1fr; gap: 18px; }
    /* Tabs scroll sideways instead of wrapping into several rows. */
    .tabs { flex-wrap: nowrap; overflow-x: auto; width: calc(100% + var(--gutter) * 2); margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) 4px; scrollbar-width: none; }
    .tab { flex: 0 0 auto; height: 42px; padding: 0 14px; font-size: 13px; }
    .card h3 { font-size: 16px; }
    .meta { font-size: 10px; }
  }
</style>

<script>
  // Only the full projects page has the toolbar; the home selection is static.
  const root = document.querySelector<HTMLElement>('.work');
  if (root?.querySelector('.toolbar')) {
    const i18n = JSON.parse(root.dataset.i18n!);
    const wall = root.querySelector<HTMLElement>('.wall')!;
    const cards = [...wall.querySelectorAll<HTMLAnchorElement>('.card')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
    const search = root.querySelector<HTMLInputElement>('input[name=q]')!;
    const sortSel = root.querySelector<HTMLSelectElement>('.sort')!;
    const countEl = root.querySelector<HTMLElement>('.count')!;
    const emptyEl = root.querySelector<HTMLElement>('.empty')!;
    const AREAS = tabs.map((b) => b.dataset.area!).filter(Boolean);

    const state = { area: '', q: '', sort: 'featured' };
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    function render(writeUrl = true) {
      const q = norm(state.q.trim());
      const list = cards.filter((c) =>
        (!state.area || c.dataset.area!.split(' ').includes(state.area)) &&
        (!q || norm(`${c.dataset.title} ${c.dataset.client}`).includes(q)));
      if (state.sort === 'newest') list.sort((a, b) => +b.dataset.year! - +a.dataset.year! || +a.dataset.order! - +b.dataset.order!);
      else if (state.sort === 'az') list.sort((a, b) => a.dataset.title!.localeCompare(b.dataset.title!));
      else list.sort((a, b) => +a.dataset.order! - +b.dataset.order!);
      // Re-inserting (instead of hiding) keeps the DOM order equal to the visual order.
      list.forEach((c, i) => (c.style.animationDelay = `${Math.min(i, 8) * 50}ms`));
      wall.replaceChildren(...list);
      emptyEl.hidden = list.length > 0;
      countEl.textContent = list.length === cards.length
        ? i18n.count.replace('{n}', cards.length)
        : i18n.showing.replace('{n}', list.length).replace('{total}', cards.length);
      tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === state.area)));

      if (writeUrl) {
        const u = new URLSearchParams();
        if (state.area) u.set('area', state.area);
        if (state.q) u.set('q', state.q);
        if (state.sort !== 'featured') u.set('sort', state.sort);
        history.replaceState(null, '', `${location.pathname}${u.size ? `?${u}` : ''}${location.hash}`);
      }
    }

    // Restore from a shared link (?area=games&sort=newest).
    const params = new URLSearchParams(location.search);
    state.area = AREAS.includes(params.get('area') ?? '') ? params.get('area')! : '';
    state.q = params.get('q') ?? '';
    state.sort = ['featured', 'newest', 'az'].includes(params.get('sort') ?? '') ? params.get('sort')! : 'featured';
    search.value = state.q;
    sortSel.value = state.sort;
    render(false);

    tabs.forEach((b) => b.addEventListener('click', () => { state.area = b.dataset.area!; render(); }));
    search.addEventListener('input', () => { state.q = search.value; render(); });
    sortSel.addEventListener('change', () => { state.sort = sortSel.value; render(); });
    root.querySelector('.clear-all')!.addEventListener('click', () => {
      Object.assign(state, { area: '', q: '' });
      search.value = '';
      render();
    });
  }
</script>
