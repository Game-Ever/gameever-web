---
import Dot from './Dot.astro';
import { Image } from 'astro:assets';
import { type Lang, type Project, useT, url, clientName, byNewest } from '../i18n';
import { AREAS, AREA_KEYS, areasOf } from '../data/taxonomy';
import { WORLD_PROJECTS } from '../data/worlds';

// variant "home": a short selection (first HOME_COUNT in Featured order, minus the projects already shown in
// the "Qué hacemos" cards) with a link to the full list.
// variant "full": every project, newest first, with area tabs (Todos / Videojuegos / Animación / Arte; an area with no
// projects gets no tab), kept in the URL (?area=games) so links can be shared. No search or sort: few people use
// them on a list this size.
interface Props { lang: Lang; projects: Project[]; variant?: 'home' | 'full' }
const { lang, variant = 'full' } = Astro.props;
const HOME_COUNT = 6;
const projects = variant === 'home'
  ? Astro.props.projects.filter((p) => !WORLD_PROJECTS.includes(p.id)).slice(0, HOME_COUNT)
  : Astro.props.projects;
const full = variant === 'full';
// The projects page is sorted by year, newest first (ties keep the Featured order).
const shown = full ? byNewest(projects) : projects;
const Heading = full ? 'h1' : 'h2';
const t = useT(lang);

const areaOf = new Map(projects.map((p) => [p.id, areasOf(p.data.services, p.data.platforms)]));
const tabs = [
  { key: '', label: t('work.allAreas'), n: projects.length },
  ...AREA_KEYS.map((k) => ({ key: k, label: AREAS[k][lang], n: projects.filter((p) => areaOf.get(p.id)!.includes(k)).length })).filter((tab) => tab.n > 0),
];
const i18n = { count: t('work.count'), showing: t('work.showing') };
---
<section class:list={['work', { home: !full }]} id="work" data-i18n={JSON.stringify(i18n)}>
  <div class="wrap">
    <span class="mono kicker">{t('work.label')}</span>
    <div class="work-head">
      <Heading class="wide"><Dot text={full ? t('work.allTitle') : t('work.title')} /></Heading>
      {full && <div class="aside on-pink"><p class="lines">{t('work.lines').map((line) => <span>{line}</span>)}</p></div>}
    </div>

    {full && (
      <div class="toolbar">
        <div class="tabs" role="group" aria-label={t('work.label')}>
          {tabs.map((tab) => (
            <button class="tab" data-area={tab.key} aria-pressed={tab.key === '' ? 'true' : 'false'}>
              {tab.label} <span class="n">{tab.n}</span>
            </button>
          ))}
        </div>
      </div>
    )}
    {full && <span class="count mono" aria-live="polite">{t('work.count', { n: projects.length })}</span>}

    <div class="wall">
      {shown.map((p, i) => (
        <a
          class="card"
          href={url(lang, `work/${p.id}`)}
          data-title={p.data.title}
          data-client={p.data.client}
          data-year={p.data.year}
          data-area={areaOf.get(p.id)!.join(' ')}
        >
          <div class="img"><Image src={p.data.cover} alt="" widths={[320, 480, 640, 960]} sizes="(max-width: 1000px) 50vw, 430px" loading={i < 6 ? "eager" : "lazy"} /></div>
          <h3>{p.data.title}</h3>
          <span class="meta mono">{clientName(p.data.client, lang)} · {p.data.years ?? p.data.year}</span>
        </a>
      ))}
    </div>
    {!full && <a class="all" href={url(lang, 'work')}>{t('work.all')} <span aria-hidden="true">→</span></a>}
  </div>
</section>

<style>
  .work { padding: 110px 0 120px; background: linear-gradient(180deg, var(--pink-d) 0, var(--bg) 420px); }
  /* On the home the selection comes right after the reel: plain dark background, pink kicker like the other sections. */
  .work.home { background: none; }
  .work.home .kicker { color: var(--pink); opacity: 1; }
  .kicker { color: #fff; opacity: 0.85; }
  .work-head { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; margin: 22px 0 36px; }
  .work-head > * { min-width: 0; }
  .work-head :is(h1, h2) { font-size: var(--title-size); line-height: 0.95; overflow-wrap: break-word; }

  /* Toolbar: the area tabs; sticks under the header. */
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; position: sticky; top: var(--header-h); z-index: 20; padding: 14px 0; /* Solid behind both rows (tabs and search wrap to two rows on phones), fading out only in the bottom padding. */ background: linear-gradient(var(--bg) calc(100% - 14px), transparent); }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .tab { display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 18px; border: 2px solid rgba(255, 255, 255, 0.35); background: none; cursor: pointer; font-weight: 800; font-stretch: 118%; text-transform: uppercase; font-size: 14px; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .tab:hover { border-color: var(--fg); }
  .tab[aria-pressed='true'] { background: var(--pink); border-color: var(--pink); color: #fff; }
  /* Each area in its color (cyan = games, violet = art), white text like the other tabs. */
  .tab[data-area='games'][aria-pressed='true'] { background: var(--cyan); border-color: var(--cyan); color: #fff; }
  .tab[data-area='art'][aria-pressed='true'] { background: var(--violet); border-color: var(--violet); color: #fff; }
  .n { font-family: var(--mono); font-size: 11px; font-weight: 400; opacity: 0.75; }
  .count { display: block; color: rgba(255, 255, 255, 0.6); margin: 10px 0 26px; }

  .wall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 28px; padding-bottom: 40px; }
  .card[hidden] { display: none; }
  .card { display: flex; flex-direction: column; gap: 12px; animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { opacity: 0; translate: 0 30px; } to { opacity: 1; translate: 0 0; } }
  /* Square thumbnails: the cover is square (two image formats on the site: 16:9 header, 1:1 cover). */
  .img { position: relative; aspect-ratio: var(--card-ratio, 1 / 1); overflow: hidden; background: var(--bg2); border-radius: 16px; }
  .img img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s; }
  .img::after { content: ''; position: absolute; right: 0; bottom: 0; width: 28px; height: 28px; background: var(--pink); transform: scale(0); transform-origin: bottom right; transition: transform 0.25s; }
  .card h3 { font-size: clamp(18px, 1.8vw, 26px); line-height: 1.05; overflow-wrap: break-word; font-stretch: 125%; font-weight: 800; text-transform: uppercase; transition: color 0.25s; }
  .meta { color: var(--mute); margin-top: -6px; }
  @media (hover: hover) {
    .card:hover img { transform: scale(1.06); filter: saturate(1.1); }
    .card:hover .img::after { transform: scale(1); }
    .card:hover h3 { color: var(--pink); }
  }
  .card:focus-visible h3 { color: var(--pink); }
  .all { display: inline-flex; gap: 12px; align-items: center; font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: 15px; border: 2px solid var(--fg); padding: 16px 24px; transition: background 0.2s, color 0.2s; }
  .all:hover { background: var(--fg); color: var(--bg); }

  @media (max-width: 1000px) {
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 16px; }
  }
  @media (max-width: 760px) {
    .work { padding-top: 80px; }
    .work-head { grid-template-columns: 1fr; gap: 18px; }
    /* Four tabs in two rows of two, full width, no sideways scroll. */
    .tabs { display: grid; grid-template-columns: 1fr 1fr; width: 100%; gap: 6px; }
    .tab { justify-content: center; gap: 8px; height: 42px; padding: 0 8px; font-size: 13px; }
    .card h3 { font-size: 16px; }
    .meta { font-size: 10px; }
  }
</style>

<script>
  // Only the full projects page has the tabs; the home selection is static.
  const root = document.querySelector<HTMLElement>('.work');
  if (root?.querySelector('.toolbar')) {
    const i18n = JSON.parse(root.dataset.i18n!);
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('.wall .card')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
    const countEl = root.querySelector<HTMLElement>('.count')!;
    const AREAS = tabs.map((b) => b.dataset.area!).filter(Boolean);
    let area = '';

    function render(writeUrl = true) {
      let shown = 0;
      cards.forEach((c) => {
        const on = !area || c.dataset.area!.split(' ').includes(area);
        c.hidden = !on;
        if (on) c.style.animationDelay = `${Math.min(shown++, 8) * 50}ms`;
        // The project page then browses (previous / next) only this area, and its back link returns here.
        c.search = area ? `?area=${area}` : '';
      });
      countEl.textContent = shown === cards.length
        ? i18n.count.replace('{n}', cards.length)
        : i18n.showing.replace('{n}', shown).replace('{total}', cards.length);
      tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === area)));
      if (writeUrl) history.replaceState(null, '', `${location.pathname}${area ? `?area=${area}` : ''}${location.hash}`);
    }

    // Restore from a shared link (?area=games). Unknown areas (or old ?q= and ?sort= links) show everything.
    const asked = new URLSearchParams(location.search).get('area') ?? '';
    // Old links to the co-production tab now open Arte, where that work lives.
    const wanted = asked === 'coproduction' ? 'art' : asked;
    area = AREAS.includes(wanted) ? wanted : '';
    render(false);
    tabs.forEach((b) => b.addEventListener('click', () => { area = b.dataset.area!; render(); }));
  }
</script>
