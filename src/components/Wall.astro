---
import { Image } from 'astro:assets';
import { type Lang, type Project, useT, url, clientName } from '../i18n';
import { SERVICES, PLATFORMS, eraOf } from '../data/taxonomy';

interface Props { lang: Lang; projects: Project[] }
const { lang, projects } = Astro.props;
const t = useT(lang);

// Only offer filter options that at least one published project uses.
const used = <T extends string>(pick: (p: Project) => T[]) => new Set(projects.flatMap(pick));
const usedServices = used((p) => p.data.services);
const usedPlatforms = used((p) => p.data.platforms);
const groups = [
  { key: 'sv', title: t('work.service'), options: Object.entries(SERVICES).filter(([k]) => usedServices.has(k as any)).map(([k, v]) => [k, v[lang]]) },
  { key: 'pf', title: t('work.platform'), options: Object.entries(PLATFORMS).filter(([k]) => usedPlatforms.has(k as any)).map(([k, v]) => [k, v[lang]]) },
  { key: 'era', title: t('work.era'), options: [...used((p) => [eraOf(p.data.year)])].sort().reverse().map((e) => [e, e]) },
];
const clients = [...used((p) => [p.data.client])].sort((a, b) => a.localeCompare(b));
const labels = Object.fromEntries(groups.flatMap((g) => g.options.map(([k, v]) => [`${g.key}:${k}`, v])));
const i18n = { count: t('work.count'), showing: t('work.showing') };
---
<section class="work" id="work" data-labels={JSON.stringify(labels)} data-i18n={JSON.stringify(i18n)}>
  <div class="wrap">
    <div class="work-head">
      <h2 class="wide">{t('work.title')}</h2>
      <span class="count mono" aria-live="polite">{t('work.count', { n: projects.length })}</span>
    </div>

    <div class="toolbar">
      <label class="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
        <span class="sr-only">{t('work.search')}</span>
        <input type="search" name="q" placeholder={t('work.search')} autocomplete="off" />
      </label>
      <button class="btn filter-btn" aria-expanded="false" aria-controls="filter-panel">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 3.4H2.4l7 8.4v5.7l3.6 1.8v-7.5z" /></svg>
        {t('work.filter')} <span class="n" hidden>0</span>
      </button>
      <select class="sort" aria-label={t('work.sort')}>
        <option value="featured">{t('work.sort.featured')}</option>
        <option value="newest">{t('work.sort.newest')}</option>
        <option value="az">{t('work.sort.az')}</option>
      </select>
    </div>

    <div class="panel" id="filter-panel">
      {groups.map((g) => (
        <div>
          <h3>{g.title}</h3>
          <div class="chips" data-group={g.key}>
            {g.options.map(([k, v]) => <button class="chip" data-k={k} aria-pressed="false">{v}</button>)}
          </div>
        </div>
      ))}
      <div>
        <h3>{t('work.client')}</h3>
        <select class="client" aria-label={t('work.client')}>
          <option value="">{t('work.allClients')}</option>
          {clients.map((c) => <option value={c}>{clientName(c, lang)}</option>)}
        </select>
      </div>
      <div class="actions">
        <button class="clear-all">{t('work.clear')}</button>
        <button class="apply">{t('work.show')}</button>
      </div>
    </div>

    <div class="active" data-clear-label={t('work.clear')}></div>

    <div class="wall">
      {projects.map((p, i) => (
        <a
          class="card"
          href={url(lang, `work/${p.id}`)}
          data-title={p.data.title}
          data-client={p.data.client}
          data-year={p.data.year}
          data-order={i}
          data-sv={p.data.services.join(' ')}
          data-pf={p.data.platforms.join(' ')}
          data-era={eraOf(p.data.year)}
        >
          <div class="img"><Image src={p.data.cover} alt="" widths={[320, 480, 640, 960]} sizes="(max-width: 1000px) 50vw, 430px" loading={i < 6 ? "eager" : "lazy"} /></div>
          <h3>{p.data.title}</h3>
          <span class="meta mono">{clientName(p.data.client, lang)} · {p.data.years ?? p.data.year}</span>
        </a>
      ))}
    </div>
    <p class="empty" hidden>{t('work.empty')} <button class="clear-all">{t('work.emptyClear')}</button></p>
  </div>
</section>

<style>
  .work { padding: 110px 0 120px; background: linear-gradient(180deg, var(--pink-d) 0, var(--bg) 420px); }
  .work-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
  .work-head h2 { font-size: clamp(40px, 6vw, 88px); line-height: 0.9; }
  .count { color: rgba(255, 255, 255, 0.75); }

  .toolbar { display: flex; gap: 8px; flex-wrap: wrap; position: sticky; top: var(--header-h); z-index: 20; padding: 12px 0; background: linear-gradient(var(--bg) 70%, transparent); }
  .search { flex: 1; min-width: 220px; max-width: 420px; display: flex; align-items: center; gap: 10px; border: 2px solid rgba(255, 255, 255, 0.8); padding: 0 14px; height: 48px; }
  .search input { flex: 1; min-width: 0; background: none; border: 0; color: var(--fg); font: 500 16px var(--sans); outline: none; }
  .search input::placeholder { color: rgba(255, 255, 255, 0.6); }
  .search:focus-within { border-color: var(--pink); }
  .btn { height: 48px; border: 2px solid rgba(255, 255, 255, 0.8); background: none; padding: 0 18px; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-stretch: 115%; text-transform: uppercase; font-size: 14px; }
  .btn:hover, .btn[aria-expanded='true'] { background: var(--fg); color: var(--bg); }
  .n { background: var(--pink); color: #fff; border-radius: 999px; font-size: 12px; min-width: 22px; height: 22px; display: grid; place-items: center; padding: 0 6px; }
  .n[hidden] { display: none; }
  .sort { height: 48px; border: 2px solid rgba(255, 255, 255, 0.8); background: var(--bg); color: var(--fg); padding: 0 12px; font: 700 14px var(--sans); text-transform: uppercase; cursor: pointer; }

  .panel { display: none; background: var(--bg2); border: 1px solid var(--line); padding: 28px; margin: 4px 0 20px; gap: 28px; grid-template-columns: 2fr 1.3fr 0.6fr 1fr; }
  .panel.open { display: grid; }
  .panel h3 { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; color: var(--mute); font-weight: 400; margin-bottom: 12px; text-transform: uppercase; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { border: 1px solid var(--line2); background: none; padding: 7px 12px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.15s; }
  .chip:hover { border-color: var(--fg); }
  .chip[aria-pressed='true'] { background: var(--pink); border-color: var(--pink); color: #fff; }
  .client { width: 100%; height: 42px; background: var(--bg); color: var(--fg); border: 1px solid var(--line2); padding: 0 10px; font: 600 14px var(--sans); }
  .actions { grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--line); padding-top: 18px; }
  .actions button { background: none; border: 0; cursor: pointer; font-weight: 700; text-transform: uppercase; font-size: 13px; font-stretch: 115%; padding: 10px 6px; }
  .actions .apply { background: var(--fg); color: var(--bg); padding: 10px 18px; }

  .active { display: flex; gap: 6px; flex-wrap: wrap; margin: 6px 0 26px; }
  .active :global(button) { background: var(--fg); color: var(--bg); border: 0; padding: 6px 10px; font-size: 13px; font-weight: 700; cursor: pointer; }
  .active :global(button)::after { content: ' ✕'; opacity: 0.6; }
  .active :global(.clear) { background: none; color: var(--fg); text-decoration: underline; }
  .active :global(.clear)::after { content: ''; }

  .wall { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; padding-bottom: 120px; }
  .card { display: flex; flex-direction: column; gap: 12px; animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .wall .card:nth-child(3n + 2) { transform: translateY(22%); }
  @keyframes rise { from { opacity: 0; translate: 0 30px; } to { opacity: 1; translate: 0 0; } }
  .img { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--bg2); }
  .img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s; filter: saturate(0.9); }
  .img::after { content: ''; position: absolute; right: 0; bottom: 0; width: 28px; height: 28px; background: var(--pink); transform: scale(0); transform-origin: bottom right; transition: transform 0.25s; }
  .card h3 { font-size: clamp(18px, 1.8vw, 26px); line-height: 1.05; font-stretch: 125%; font-weight: 800; text-transform: uppercase; transition: color 0.25s; }
  .meta { color: var(--mute); margin-top: -6px; }
  @media (hover: hover) {
    .card:hover img { transform: scale(1.06); filter: saturate(1.15); }
    .card:hover .img::after { transform: scale(1); }
    .card:hover h3 { color: var(--pink); }
  }
  .card:focus-visible h3 { color: var(--pink); }
  .empty { text-align: center; padding: 80px 0; color: var(--mute); }
  .empty button { background: none; border: 0; color: var(--fg); text-decoration: underline; cursor: pointer; font-weight: 700; }

  @media (max-width: 1000px) {
    .wall { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .wall .card:nth-child(3n + 2) { transform: none; }
    .wall .card:nth-child(2n) { transform: translateY(18%); }
    .panel { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .work { padding-top: 80px; }
    .search { min-width: 100%; max-width: none; }
    .btn, .sort { flex: 1; }
    .panel { grid-template-columns: 1fr; padding: 20px; }
    .card h3 { font-size: 16px; }
    .meta { font-size: 10px; }
  }
</style>

<script>
  type Group = 'sv' | 'pf' | 'era';
  const root = document.querySelector<HTMLElement>('.work');
  if (root) {
    const labels: Record<string, string> = JSON.parse(root.dataset.labels!);
    const i18n = JSON.parse(root.dataset.i18n!);
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const wall = $<HTMLElement>('.wall');
    const cards = [...wall.querySelectorAll<HTMLAnchorElement>('.card')];
    const search = $<HTMLInputElement>('input[name=q]');
    const sortSel = $<HTMLSelectElement>('.sort');
    const clientSel = $<HTMLSelectElement>('.client');
    const panel = $<HTMLElement>('.panel');
    const filterBtn = $<HTMLButtonElement>('.filter-btn');
    const activeEl = $<HTMLElement>('.active');
    const countEl = $<HTMLElement>('.count');
    const emptyEl = $<HTMLElement>('.empty');
    const badge = $<HTMLElement>('.n');

    const state = { q: '', sort: 'featured', client: '', sv: new Set<string>(), pf: new Set<string>(), era: new Set<string>() };
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const has = (card: HTMLElement, g: Group) => !state[g].size || card.dataset[g]!.split(' ').some((k) => state[g].has(k));

    function render(writeUrl = true) {
      const q = norm(state.q.trim());
      let list = cards.filter((c) =>
        (!q || norm(`${c.dataset.title} ${c.dataset.client}`).includes(q)) &&
        has(c, 'sv') && has(c, 'pf') && has(c, 'era') &&
        (!state.client || c.dataset.client === state.client));
      if (state.sort === 'newest') list.sort((a, b) => +b.dataset.year! - +a.dataset.year! || +a.dataset.order! - +b.dataset.order!);
      else if (state.sort === 'az') list.sort((a, b) => a.dataset.title!.localeCompare(b.dataset.title!));
      else list.sort((a, b) => +a.dataset.order! - +b.dataset.order!);
      // Re-inserting (instead of hiding) keeps the staggered nth-child layout intact.
      list.forEach((c, i) => c.style.animationDelay = `${Math.min(i, 8) * 50}ms`);
      wall.replaceChildren(...list);
      emptyEl.hidden = list.length > 0;
      countEl.textContent = list.length === cards.length
        ? i18n.count.replace('{n}', cards.length)
        : i18n.showing.replace('{n}', list.length).replace('{total}', cards.length);

      root!.querySelectorAll<HTMLElement>('.chips').forEach((box) =>
        box.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) =>
          b.setAttribute('aria-pressed', String(state[box.dataset.group as Group].has(b.dataset.k!)))));
      const tags = (['sv', 'pf', 'era'] as Group[]).flatMap((g) => [...state[g]].map((k) => ({ g, k, label: labels[`${g}:${k}`] ?? k })));
      if (state.client) tags.push({ g: 'client' as Group, k: state.client, label: clientSel.selectedOptions[0]?.textContent ?? state.client });
      activeEl.replaceChildren(...tags.map(({ g, k, label }) => {
        const b = document.createElement('button');
        b.textContent = label;
        b.dataset.g = g;
        b.dataset.k = k;
        return b;
      }));
      if (tags.length) activeEl.append(Object.assign(document.createElement('button'), { className: 'clear', textContent: activeEl.dataset.clearLabel }));
      badge.hidden = !tags.length;
      badge.textContent = String(tags.length);

      if (writeUrl) {
        const u = new URLSearchParams();
        (['sv', 'pf', 'era'] as Group[]).forEach((g) => state[g].size && u.set(g, [...state[g]].join(',')));
        if (state.client) u.set('client', state.client);
        if (state.q) u.set('q', state.q);
        if (state.sort !== 'featured') u.set('sort', state.sort);
        history.replaceState(null, '', `${location.pathname}${u.size ? `?${u}` : ''}${location.hash}`);
      }
    }

    function clearAll() {
      state.q = ''; state.client = '';
      state.sv.clear(); state.pf.clear(); state.era.clear();
      search.value = ''; clientSel.value = '';
      render();
    }

    // Restore state from a shared link, e.g. ?sv=codev&sort=newest
    const params = new URLSearchParams(location.search);
    (['sv', 'pf', 'era'] as Group[]).forEach((g) => (params.get(g) ?? '').split(',').filter(Boolean).forEach((k) => state[g].add(k)));
    state.client = params.get('client') ?? '';
    state.q = params.get('q') ?? '';
    state.sort = ['featured', 'newest', 'az'].includes(params.get('sort') ?? '') ? params.get('sort')! : 'featured';
    clientSel.value = state.client; search.value = state.q; sortSel.value = state.sort;
    render(false);

    search.addEventListener('input', () => { state.q = search.value; render(); });
    sortSel.addEventListener('change', () => { state.sort = sortSel.value; render(); });
    clientSel.addEventListener('change', () => { state.client = clientSel.value; render(); });
    root.querySelectorAll<HTMLElement>('.chips').forEach((box) => box.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!chip) return;
      const set = state[box.dataset.group as Group];
      set.has(chip.dataset.k!) ? set.delete(chip.dataset.k!) : set.add(chip.dataset.k!);
      render();
    }));
    const togglePanel = (open: boolean) => { panel.classList.toggle('open', open); filterBtn.setAttribute('aria-expanded', String(open)); };
    filterBtn.addEventListener('click', () => togglePanel(!panel.classList.contains('open')));
    $('.apply').addEventListener('click', () => { togglePanel(false); root.scrollIntoView(); });
    root.querySelectorAll('.clear-all').forEach((b) => b.addEventListener('click', clearAll));
    activeEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.classList.contains('clear')) return clearAll();
      if (b.dataset.g === 'client') { state.client = ''; clientSel.value = ''; }
      else state[b.dataset.g as Group].delete(b.dataset.k!);
      render();
    });
    // Service blocks further down can jump here with a preset filter.
    document.querySelectorAll<HTMLElement>('[data-jump-service]').forEach((el) => el.addEventListener('click', (e) => {
      e.preventDefault();
      clearAll();
      state.sv.add(el.dataset.jumpService!);
      render();
      root.scrollIntoView();
    }));
  }
</script>
