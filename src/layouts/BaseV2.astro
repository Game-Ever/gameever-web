---
// v2 design (GDC-style structure, Game Ever colors). Not indexed: it exists to compare against the main design.
import { Image } from 'astro:assets';
import logo from '../assets/logo-game-ever.png';
import { type Lang, SOCIAL, url, withBase } from '../i18n';
import { useV2, v2url } from '../i18n/v2';

interface Props { lang: Lang; path: string; title?: string; description?: string }
const { lang, path, title, description } = Astro.props;
const t = useV2(lang);
const other: Lang = lang === 'en' ? 'es' : 'en';
const home = v2url(lang);
const nav = [
  { href: `${home}#paths`, label: lang === 'es' ? 'Servicios' : 'Services' },
  { href: `${home}#featured`, label: lang === 'es' ? 'Destacados' : 'Featured' },
  { href: `${home}#archive`, label: lang === 'es' ? 'Proyectos' : 'Projects' },
  { href: `${home}#videos`, label: lang === 'es' ? 'Videos' : 'Videos' },
  { href: `${home}#clients`, label: lang === 'es' ? 'Clientes' : 'Clients' },
  { href: '#contact', label: lang === 'es' ? 'Contacto' : 'Contact' },
];
const pageTitle = title ? `${title} — Game Ever (v2)` : 'Game Ever (v2)';
const icons: Record<string, string> = {
  LinkedIn: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 21 11.2 21 14.5V21h-4v-5.8c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.5-2.25 3.1V21H9z',
  YouTube: 'M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9l5.8 3.1z',
  // Outer rounded square, lens ring and flash dot (even-odd fill cuts the holes).
  Instagram: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM17.3 5.4a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6z',
  X: 'M17.7 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5.2 21H2.1l7.3-8.3L1.7 3h6.4l4.4 5.9zm-1.1 16.2h1.7L7.4 4.7H5.6z',
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Figtree:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="hdr">
    <div class="bar">
      <button class="menu-btn" aria-expanded="false" aria-controls="v2-menu">
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>{t('menu')}
      </button>
      <a class="logo" href={home} aria-label="Game Ever"><Image src={logo} alt="Game Ever" height={40} densities={[1, 2]} loading="eager" /></a>
      <div class="right">
        <a class="pill pink" href="mailto:info@gameeverstudio.com">{t('cta')} <span aria-hidden="true">→</span></a>
        <a class="pill white" href={v2url(other, path)} hreflang={other} lang={other}>{other.toUpperCase()}</a>
      </div>
    </div>
    <nav id="v2-menu" class="menu" aria-label="Main">
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
  </header>

  <slot />

  <footer class="ftr" id="contact">
    <div class="ftr-top">
      <div class="wrap">
        <p class="tag">{t('footer.tag')}</p>
        <div class="cols">
          <div><span>{t('footer.mail')}</span><a href="mailto:info@gameeverstudio.com">info@gameeverstudio.com</a></div>
          <div><span>{t('footer.jobs')}</span><a href="mailto:jobs@gameeverstudio.com">jobs@gameeverstudio.com</a></div>
          <div><span>Game Ever S.A.</span>{t('footer.studio')}</div>
        </div>
        <ul class="social">
          {SOCIAL.map((s) => (
            <li><a href={s.url} target="_blank" rel="me noopener" aria-label={s.label}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d={icons[s.label]} /></svg></a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="ftr-bottom">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Game Ever S.A.</span>
        <a href={url(lang, path)}>{lang === 'es' ? 'Ver diseño actual (D)' : 'See current design (D)'}</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --pink: #ff1f6b;
    --pink-d: #d9104f;
    --ink: #0d0d0f;
    --ink2: #3d3c42;
    --blush: #ffe1ea;
    --candy: #ff8db0;
    --white: #ffffff;
    --line: #e7e3e4;
    --display: 'Anton', 'Impact', sans-serif;
    --body: 'Figtree', system-ui, sans-serif;
    --gutter: 20px;
    --bar-h: 72px;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: calc(var(--bar-h) + 16px); }
  body { background: var(--white); color: var(--ink); font-family: var(--body); font-size: 18px; line-height: 1.55; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
  img { display: block; max-width: 100%; }
  a { color: inherit; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 var(--gutter); }
  .display { font-family: var(--display); font-weight: 400; text-transform: uppercase; line-height: 0.95; letter-spacing: 0.005em; }
  .h2 { font-family: var(--display); font-weight: 400; font-size: clamp(40px, 4.2vw, 64px); line-height: 1; }
  .pill { display: inline-flex; align-items: center; gap: 10px; border-radius: 48px; padding: 13px 30px 11px; font-weight: 800; font-size: 15px; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; border: 2px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s; white-space: nowrap; }
  .pill:hover { transform: translateY(-2px); }
  .pill.pink { background: var(--pink); color: #fff; }
  .pill.pink:hover { background: var(--pink-d); }
  .pill.ink { background: var(--ink); color: #fff; }
  .pill.ink:hover { background: var(--pink); }
  .pill.white { background: #fff; color: var(--ink); }
  .pill.white:hover { border-color: var(--pink); }
  .pill.outline { border-color: currentColor; background: transparent; }
  .link { display: inline-block; font-weight: 800; font-size: 15px; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; border-bottom: 2px solid var(--pink); padding-bottom: 2px; transition: color 0.2s; }
  .link:hover { color: var(--pink); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 900px) { :root { --gutter: 32px; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; }
  .bar { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: var(--bar-h); padding: 0 var(--gutter); background: var(--ink); color: #fff; }
  .menu-btn { justify-self: start; display: inline-flex; align-items: center; gap: 12px; background: none; border: 0; cursor: pointer; font-weight: 700; font-size: 15px; height: 100%; padding-right: 20px; border-right: 1px solid rgba(255, 255, 255, 0.2); }
  .burger { display: grid; gap: 5px; width: 22px; }
  .burger i { display: block; height: 2px; background: currentColor; transition: transform 0.25s, opacity 0.25s; }
  .menu-btn[aria-expanded='true'] .burger i:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .burger i:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] .burger i:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .logo img { height: 40px; width: auto; }
  .right { justify-self: end; display: flex; gap: 10px; }
  .menu { display: none; background: var(--pink); color: #fff; }
  .menu.open { display: block; }
  .menu ul { list-style: none; padding: 24px var(--gutter) 32px; max-width: 1440px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 4px 32px; }
  .menu a { display: block; font-family: var(--display); font-size: clamp(32px, 4vw, 48px); text-transform: uppercase; text-decoration: none; padding: 6px 0; border-bottom: 2px solid rgba(255, 255, 255, 0.35); }
  .menu a:hover { border-color: #fff; }

  .ftr-top { background: var(--pink); color: #fff; padding: 80px 0 56px; }
  .tag { font-family: var(--display); font-size: clamp(40px, 7.5vw, 120px); line-height: 0.95; text-transform: uppercase; overflow-wrap: anywhere; }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; font-size: 17px; }
  .cols div { min-width: 0; overflow-wrap: anywhere; }
  .cols span { display: block; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; font-size: 13px; opacity: 0.85; margin-bottom: 6px; }
  .cols a { font-weight: 700; font-size: 20px; text-decoration: none; border-bottom: 2px solid rgba(255, 255, 255, 0.5); }
  .cols a:hover { border-color: #fff; }
  .social { list-style: none; padding: 0; display: flex; gap: 12px; margin-top: 40px; }
  .social a { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #fff; transition: transform 0.2s; }
  .social a:hover { transform: scale(1.08); }
  .social svg { width: 24px; height: 24px; fill: var(--ink); }
  .ftr-bottom { background: var(--ink); color: #fff; padding: 22px 0; font-size: 14px; }
  .ftr-bottom .wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .ftr-bottom a { text-decoration: none; border-bottom: 1px solid var(--pink); }

  @media (max-width: 760px) {
    .bar { grid-template-columns: auto 1fr auto; gap: 10px; }
    .logo { justify-self: center; }
    .logo img { height: 30px; }
    .menu-btn { padding-right: 12px; font-size: 0; gap: 0; }
    .right .pink { display: none; }
    .right .white { padding: 9px 16px 7px; }
    .cols { grid-template-columns: 1fr; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('v2-menu')!;
  const toggle = (open: boolean) => { menu.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); };
  btn.addEventListener('click', () => toggle(!menu.classList.contains('open')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });
</script>
